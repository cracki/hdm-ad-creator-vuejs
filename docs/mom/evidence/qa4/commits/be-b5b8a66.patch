+    def test_sections_without_service_names_use_index_fallback(self):
+        engine = self._engine()
+        result = _budget_fixture(
+            bpc=[{"bpc_score": 30}, {"bpc_score": 70}],
+            ranking=[{"rank": 1, "opportunity_score": 10}, {"opportunity_score": 90}],
+            blueprints=[{"priority": "1"}, {"priority": "2"}],
