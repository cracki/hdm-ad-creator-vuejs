diff --git a/django-backend/campaign/services/completion.py b/django-backend/campaign/services/completion.py
index a511e1f..51567eb 100644
--- a/django-backend/campaign/services/completion.py
+++ b/django-backend/campaign/services/completion.py
@@ -143,3 +143,90 @@ def get_completion_error(campaign: Campaign) -> Tuple[Optional[str], List[str]]:
         )
 
     return None, []
+
+
+# --- Derived (post-gate) completion flags (QA4-img29/new5) -----------------
+#
+# The completion gate above only covers step types; ad generation, visual
+# generation and ad review happen AFTER the wizard steps and are not
+# ``CampaignStepTypeChoices`` members, so they can never be part of
+# ``get_completion_error``. These helpers expose them as informational
+# read-only flags for the FE (and the campaign serializer); they are NOT
+# completion gates and never block ``complete_campaign``.
+#
+# Proxies (best available storage, see the per-helper docstrings):
+# - ``ad_generation_completed``: at least one ``CampaignAd`` row
+#   (``Campaign.ads``, models.py related_name="ads").
+# - ``visual_completed``: at least one ad carries a SUCCESSFUL visual record
+#   (``ad.data["latest_generated_visual"]`` or any entry of
+#   ``ad.data["generated_visuals"]`` with an ``image_url``) — the exact
+#   persistence shape used by ``campaign/services/visual_generation.py``.
+# - ``review_completed``: at least one ad has
+#   ``ad.data["review_status"] == "approved"`` — the per-ad review decision
+#   stored by ``campaign/services/ad_review.py`` (absent = not reviewed).
+
+
+def has_generated_ads(campaign: Campaign) -> bool:
+    """True when the campaign has at least one generated ad row."""
+    try:
+        return campaign.ads.exists()
+    except Exception:
+        # A campaign without the ads relation (unsaved/legacy mock) must
+        # never break serialization: missing rows simply mean False.
+        return False
+
+
+def _ad_data_has_visual(ad_data: Any) -> bool:
+    if not isinstance(ad_data, dict):
+        return False
+    latest = ad_data.get("latest_generated_visual")
+    if isinstance(latest, dict) and latest.get("image_url"):
+        return True
+    records = ad_data.get("generated_visuals")
+    if isinstance(records, list):
+        for record in records:
+            if isinstance(record, dict) and record.get("image_url"):
+                return True
+    return False
+
+
+def has_generated_visual(campaign: Campaign) -> bool:
+    """True when at least one ad carries a successfully generated visual."""
+    try:
+        for ad_data in campaign.ads.values_list("data", flat=True):
+            if _ad_data_has_visual(ad_data):
+                return True
+    except Exception:
+        return False
+    return False
+
+
+def has_approved_ad_review(campaign: Campaign) -> bool:
+    """True when at least one ad's review decision is ``approved``."""
+    try:
+        for ad_data in campaign.ads.values_list("data", flat=True):
+            if (
+                isinstance(ad_data, dict)
+                and ad_data.get("review_status") == "approved"
+            ):
+                return True
+    except Exception:
+        return False
+    return False
+
+
+def get_derived_completion_flags(campaign: Campaign) -> dict:
+    """
+    Return the three derived post-wizard flags for ``campaign``:
+
+    ``{"ad_generation_completed": bool, "visual_completed": bool,
+    "review_completed": bool}``
+
+    Always a plain dict of booleans — False whenever the underlying rows are
+    missing — so the campaign serializer can expose it unconditionally.
+    """
+    return {
+        "ad_generation_completed": has_generated_ads(campaign),
+        "visual_completed": has_generated_visual(campaign),
+        "review_completed": has_approved_ad_review(campaign),
+    }
