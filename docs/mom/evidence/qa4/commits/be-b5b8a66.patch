+"""QA4 regression tests.
+
+Covers four QA items:
+- QA4-img14: ``budget_share`` must be stamped on EVERY PPC card (services
+  bpc scores, ppc_opportunity_ranking and ppc_blueprints), weighted by
+  opportunity_score (bpc_score fallback), ints summing to exactly 100.
+- QA4-img29/new5: finishing the last selected platform's ads strategy must
+  NOT flip the campaign COMPLETED anymore; completion stays the explicit
+  POST /complete/ action.
+- derived completion flags (ad generation / visual / review) exposed on the
+  campaign serializer without erroring on campaigns without ads.
+- QA4-img18: the text sanitizer strips platform bracket tags
+  case-insensitively but preserves exact-match keywords ("[plumber]"), and
+  the ads-strategy sanitizer skips values under "keywords" keys.
+"""
+
+import os
+from unittest.mock import AsyncMock, patch
+
+from django.test import SimpleTestCase, TestCase
+
+from authentication.models import User
+from brand.models import Brand, Industry
+from campaign.engines.ads_strategy_engine import AdsStrategyEngine
+from campaign.engines.ppc_viability_engine import PPCViabilityEngine
+from campaign.engines.platform_recommendation_engine import (
+    PlatformRecommendationEngine,
+)
+from campaign.models import (
+    Campaign,
+    CampaignAd,
+    CampaignStatusChoices,
+    CampaignStep,
+    CampaignStepStatusChoices,
+    CampaignStepTypeChoices,
+)
+from campaign.serializers import CampaignSerializer
+from campaign.services.ads_strategy import CampaignAdsStrategyService
+from campaign.services.completion import get_derived_completion_flags
+from campaign.text_utils import clean_llm_text
+
+
+def _budget_fixture(bpc, ranking, blueprints):
+    """Build a minimal PPC viability result with the three card sections."""
+    return {
+        "summary": {
+            "recommended_initial_budget_allocation": {
+                "google": 40,
+                "meta": 40,
+                "linkedin": 20,
+            }
+        },
+        "brand_trust_analysis": {
+            "services_bpc_scores": bpc,
+        },
+        "strategic_prioritization": {
+            "ppc_opportunity_ranking": ranking,
+            "ppc_blueprints": blueprints,
+        },
+    }
+
+
+class QA4ServiceBudgetShareCardsTests(SimpleTestCase):
+    """QA4-img14: budget_share on every PPC card, weighted, summing to 100."""
+
+    def setUp(self):
+        # Engine constructors require an LLM key; keep tests hermetic.
+        env = patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"})
+        env.start()
+        self.addCleanup(env.stop)
+
+    def _engine(self):
+        return PPCViabilityEngine()
+
+    def _named_fixture(self):
+        return _budget_fixture(
+            bpc=[
+                {"service": "SEO", "bpc_score": 80},
+                {"service": "Workshops", "bpc_score": 20},
+                {"service": "Retreats", "bpc_score": 40},
+            ],
+            ranking=[
+                {"rank": 1, "service": "seo", "opportunity_score": 90},
+                {"rank": 2, "service": "Retreats", "opportunity_score": 40},
+                {"rank": 3, "service": "Workshops", "opportunity_score": 10},
+            ],
+            blueprints=[
+                {"service": "SEO", "priority": "1"},
+                {"service": "Workshops", "priority": "2"},
+                {"service": "Retreats", "priority": "2"},
+            ],
+        )
+
+    def _sections(self, result):
+        return (
+            result["brand_trust_analysis"]["services_bpc_scores"],
+            result["strategic_prioritization"]["ppc_opportunity_ranking"],
+            result["strategic_prioritization"]["ppc_blueprints"],
+        )
+
+    def test_budget_share_stamped_on_all_cards_and_sums_to_100(self):
+        engine = self._engine()
+        result = self._named_fixture()
+
+        engine._apply_service_budget_shares(result)
+
+        for rows in self._sections(result):
+            shares = [row["budget_share"] for row in rows]
+            self.assertEqual(len(shares), len(rows))
+            for share in shares:
+                self.assertIsInstance(share, int)
+            self.assertEqual(sum(shares), 100)
+
+    def test_higher_opportunity_score_gets_at_least_as_large_share(self):
+        engine = self._engine()
+        result = self._named_fixture()
+
+        engine._apply_service_budget_shares(result)
+
+        bpc_rows, ranking_rows, blueprint_rows = self._sections(result)
+        # Weighting uses the ranking's opportunity_score (90/40/10), so the
+        # share order follows it, not the bpc order in the fixture.
+        seo_share = next(
+            row["budget_share"] for row in ranking_rows if row["service"] == "seo"
+        )
+        workshops_share = next(
+            row["budget_share"]
+            for row in ranking_rows
+            if row["service"] == "Workshops"
+        )
+        self.assertGreaterEqual(seo_share, workshops_share)
+        self.assertGreater(seo_share, workshops_share)
+
+        # The same per-service split is stamped on every card section.
+        self.assertEqual(
+            {row["service"].casefold(): row["budget_share"] for row in bpc_rows},
+            {
+                row["service"].casefold(): row["budget_share"]
+                for row in ranking_rows
+            },
+        )
+        self.assertEqual(
+            [row["budget_share"] for row in blueprint_rows],
+            [row["budget_share"] for row in bpc_rows],
+        )
+
+    def test_bpc_score_fallback_when_ranking_score_missing(self):
+        engine = self._engine()
+        result = _budget_fixture(
+            bpc=[
+                {"service": "SEO", "bpc_score": 75},
+                {"service": "Workshops", "bpc_score": 25},
+            ],
+            ranking=[
+                {"rank": 1, "service": "SEO", "opportunity_score": "n/a"},
+            ],
+            blueprints=[{"service": "SEO"}, {"service": "Workshops"}],
+        )
+
+        engine._apply_service_budget_shares(result)
+
+        bpc_rows = result["brand_trust_analysis"]["services_bpc_scores"]
+        seo_share = next(
+            row["budget_share"] for row in bpc_rows if row["service"] == "SEO"
+        )
+        workshops_share = next(
+            row["budget_share"]
+            for row in bpc_rows
+            if row["service"] == "Workshops"
+        )
+        # SEO's opportunity_score is unusable -> its bpc_score weights it.
+        self.assertGreater(seo_share, workshops_share)
+        self.assertEqual(seo_share + workshops_share, 100)
+        # Blueprint-only service (Workshops) still gets an explicit share.
+        blueprint_shares = [
+            row["budget_share"]
+            for row in result["strategic_prioritization"]["ppc_blueprints"]
+        ]
+        self.assertEqual(sum(blueprint_shares), 100)
+
+    def test_idempotent_on_rerun(self):
+        engine = self._engine()
+        result = self._named_fixture()
+
+        engine._apply_service_budget_shares(result)
+        snapshot = [
+            {row["service"]: row.get("budget_share") for row in rows}
+            for rows in self._sections(result)
+        ]
+
+        engine._apply_service_budget_shares(result)
+        rerun = [
+            {row["service"]: row.get("budget_share") for row in rows}
+            for rows in self._sections(result)
+        ]
+
+        self.assertEqual(snapshot, rerun)
