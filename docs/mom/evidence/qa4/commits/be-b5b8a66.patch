+        env.start()
+        self.addCleanup(env.stop)
+
+    def test_platform_tags_stripped_case_insensitively(self):
+        self.assertEqual(clean_llm_text("Use [Meta] and [linkedin]"), "Use and")
+        self.assertEqual(clean_llm_text("[GOOGLE] first"), "first")
+
+    def test_exact_match_keyword_preserved_in_message(self):
+        self.assertEqual(
+            clean_llm_text("Bid on [plumber] now"), "Bid on [plumber] now"
+        )
+        self.assertEqual(
+            clean_llm_text("Ordinary [note with spaces] stays"),
+            "Ordinary [note with spaces] stays",
+        )
+
+    def test_internal_field_tag_still_stripped(self):
+        self.assertEqual(
+            clean_llm_text("[bpc_score] drives the split"),
+            "drives the split",
+        )
+
+    def test_ads_sanitizer_skips_keyword_values(self):
+        engine = AdsStrategyEngine()
+        payload = {
+            "keywords": ["[plumber]", "[google]", "[Meta]", "emergency plumber"],
+            "message": "[Meta] Bid on [plumber] today",
+            "targeting": {"keywords": ["[roof repair]"], "headline": "[linkedin] ads"},
+        }
+
+        engine._sanitize_free_text(payload)
+
+        self.assertEqual(
+            payload["keywords"],
+            ["[plumber]", "[google]", "[Meta]", "emergency plumber"],
+        )
+        self.assertEqual(payload["targeting"]["keywords"], ["[roof repair]"])
+        # Non-keyword strings are still cleaned.
+        self.assertEqual(payload["message"], "Bid on [plumber] today")
+        self.assertEqual(payload["targeting"]["headline"], "ads")
