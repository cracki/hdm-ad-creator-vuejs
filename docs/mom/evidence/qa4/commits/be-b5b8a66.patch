+class QA4AdsStrategyStatusTests(TestCase):
+    """QA4-img29/new5: ads strategy must never auto-complete the campaign."""
+
+    def setUp(self):
+        self.user = User.objects.create_user(
+            email="qa4-status-user@example.com",
+            password="StrongPass123!",
+        )
+        self.industry = Industry.objects.create(name="QA4 Status")
+        self.brand = Brand.objects.create(
+            website_url="https://example-qa4-status.com",
+            company_name="Example QA4 Status",
+            selected_industry=self.industry,
+            created_by=self.user,
+        )
+        self.campaign = Campaign.objects.create(
+            brand=self.brand,
+            name="QA4 Status Campaign",
+            created_by=self.user,
+        )
+        # Ads strategy reads personas from the latest completed segmentation.
+        CampaignStep.objects.create(
+            campaign=self.campaign,
+            step_type=CampaignStepTypeChoices.SEGMENTATION,
+            status=CampaignStepStatusChoices.COMPLETED,
+            response_payload={"data": {"segments": [{"persona_name": "P1"}]}},
+        )
+
+    def _run_platform(self, platform):
+        service = CampaignAdsStrategyService()
+        engine_result = {
+            "success": True,
+            "platform": platform,
+            "data": {"funnel_campaigns": []},
+        }
+        with patch("campaign.services.ads_strategy.AdsStrategyEngine") as engine_class:
+            engine_class.return_value.generate_strategy = AsyncMock(
+                return_value=engine_result
+            )
+            service.run(campaign=self.campaign, platform=platform)
+        self.campaign.refresh_from_db()
+
+    def test_last_platform_strategy_keeps_campaign_in_progress(self):
+        self.campaign.context_payload = {"selected_platforms": ["meta", "google", "linkedin"]}
+        self.campaign.segmentation_completed = True
+        self.campaign.ppc_viability_completed = True
+        self.campaign.funnel_completed = True
+        self.campaign.content_strategy_completed = True
+        self.campaign.save()
+
+        for platform in ("meta", "google", "linkedin"):
+            self._run_platform(platform)
+
+        self.assertTrue(self.campaign.meta_ads_completed)
+        self.assertTrue(self.campaign.google_ads_completed)
+        self.assertTrue(self.campaign.linkedin_ads_completed)
+        # The completion gate is satisfied, but completion stays the explicit
+        # POST /complete/ action: the campaign must NOT be COMPLETED yet.
+        self.assertEqual(self.campaign.status, CampaignStatusChoices.IN_PROGRESS)
+
+    def test_draft_campaign_is_promoted_to_in_progress_not_completed(self):
+        self.assertEqual(self.campaign.status, CampaignStatusChoices.DRAFT)
+
+        self._run_platform("meta")
+
+        self.assertTrue(self.campaign.meta_ads_completed)
+        self.assertEqual(self.campaign.status, CampaignStatusChoices.IN_PROGRESS)
+
