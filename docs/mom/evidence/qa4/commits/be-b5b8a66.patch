+            if key and key not in opportunity_scores:
+                opportunity_scores[key] = _coerce_non_negative_number(
+                    entry.get("opportunity_score")
+                )
+
+        weights: Dict[str, float] = {}
+        for key in dict.fromkeys(list(bpc_scores) + list(opportunity_scores)):
+            opportunity = opportunity_scores.get(key)
