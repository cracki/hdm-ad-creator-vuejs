+class SharedIdentityCopyOnWriteTests(APITestCase):
+    """Two users, two brands, one identity: refreshes stay isolated."""
+
+    def setUp(self):
+        # Engine constructors require LLM keys; keep tests hermetic.
+        env = patch.dict(
+            os.environ,
+            {"OPENAI_API_KEY": "test-key", "SERPER_API_KEY": "test-key"},
+        )
+        env.start()
+        self.addCleanup(env.stop)
+
+        self.user_a = User.objects.create_user(
+            email="copy-on-write-a@example.com",
+            password="StrongPass123!",
+        )
+        self.user_b = User.objects.create_user(
+            email="copy-on-write-b@example.com",
+            password="StrongPass123!",
+        )
+        self.industry = Industry.objects.create(name="SaaS")
+        # Same website URL for both users -> same (shared) BrandIdentity.
+        self.brand_a = Brand.objects.create(
+            website_url="https://shared-site.com",
+            company_name="Brand A",
+            selected_industry=self.industry,
+            created_by=self.user_a,
+        )
+        self.brand_b = Brand.objects.create(
+            website_url="https://shared-site.com",
+            company_name="Brand B",
+            selected_industry=self.industry,
+            created_by=self.user_b,
+        )
+        self.assertEqual(self.brand_a.identity, self.brand_b.identity)
+
+    def _orchestrator(self):
+        return BrandAnalysisOrchestrator()
+
+    def _patch_scraper(self, title):
+        return patch(
+            "core.utils.scraper.WebsiteScraper.scrape_website",
+            new=AsyncMock(return_value=_scraped_payload(title)),
+        )
+
+    def _patch_core_analyzer(self, orchestrator, company_name):
+        return patch.object(
+            orchestrator.brand_core_analyzer,
+            "_analyze_brand_core",
+            new=AsyncMock(return_value=_analysis_payload(company_name)),
+        )
+
+    def test_force_refresh_by_user_a_does_not_mutate_user_b_owned_rows(self):
+        BrandWebsiteData.objects.create(
+            identity=self.brand_a.identity,
+            brand=self.brand_b,
+            website_url=self.brand_b.website_url,
+            title="B Original",
+            full_text="b original text",
+        )
+        BrandCoreAnalysis.objects.create(
+            identity=self.brand_a.identity,
+            brand=self.brand_b,
+            company_name="B Original Co",
+            industry="SaaS",
+        )
+        b_website = BrandWebsiteData.objects.get(brand=self.brand_b)
+        b_core = BrandCoreAnalysis.objects.get(brand=self.brand_b)
+
+        orchestrator = self._orchestrator()
+        with self._patch_scraper("A Fresh") as scraper_mock, self._patch_core_analyzer(
+            orchestrator, "A Fresh Co"
+        ):
+            a_website = async_to_sync(
+                orchestrator._get_or_scrape_website_data
+            )(self.brand_a, force_refresh=True)
+            a_core = async_to_sync(
+                orchestrator._get_or_analyze_and_persist_core_analysis
+            )(
+                brand=self.brand_a,
+                website_data=a_website,
+                force_refresh=True,
+            )
+
+        # User A's refresh wrote A-owned rows.
+        self.assertEqual(a_website.brand, self.brand_a)
+        self.assertEqual(a_core.brand, self.brand_a)
+        self.assertEqual(a_website.title, "A Fresh")
+        self.assertEqual(a_core.company_name, "A Fresh Co")
+
+        # User B's rows were NOT mutated by A's refresh.
+        self.assertEqual(
+            BrandWebsiteData.objects.get(pk=b_website.pk).title, "B Original"
+        )
+        self.assertEqual(
+            BrandCoreAnalysis.objects.get(pk=b_core.pk).company_name,
+            "B Original Co",
+        )
+
+        # User B's brand reads its OWN row (cache hit, no re-scrape).
+        orchestrator_b = self._orchestrator()
+        with self._patch_scraper("Should Not Scrape") as scraper_mock:
+            b_read = async_to_sync(
+                orchestrator_b._get_or_scrape_website_data
+            )(self.brand_b)
+        scraper_mock.assert_not_called()
+        self.assertEqual(b_read.pk, b_website.pk)
+        self.assertEqual(b_read.brand, self.brand_b)
+        self.assertEqual(b_read.title, "B Original")
+
+    def test_brand_owned_row_reused_without_rescrape(self):
+        owned = BrandWebsiteData.objects.create(
+            identity=self.brand_a.identity,
+            brand=self.brand_a,
+            website_url=self.brand_a.website_url,
+            title="A Owned",
+            full_text="a owned text",
+        )
+        shared = BrandWebsiteData.objects.create(
+            identity=self.brand_a.identity,
+            website_url=self.brand_a.website_url,
+            title="Shared Stale",
+            full_text="shared text",
+        )
+        # Pin ordering deterministically: the shared row is newer than the
+        # brand-owned row, yet the owned row must still win the lookup.
+        BrandWebsiteData.objects.filter(pk=owned.pk).update(
+            updated_at=timezone.now() - timedelta(minutes=10)
+        )
+        BrandWebsiteData.objects.filter(pk=shared.pk).update(
+            updated_at=timezone.now() - timedelta(minutes=5)
+        )
+
+        orchestrator = self._orchestrator()
+        with self._patch_scraper("Should Not Scrape") as scraper_mock:
+            result = async_to_sync(orchestrator._get_or_scrape_website_data)(
+                self.brand_a
+            )
+        scraper_mock.assert_not_called()
+        self.assertEqual(result.pk, owned.pk)
+        self.assertEqual(result.brand, self.brand_a)
+        self.assertNotEqual(result.pk, shared.pk)
+
+        # Lookup order: a brand with NO owned row falls back to the newest
+        # shared identity-level row, read-only.
+        orchestrator_b = self._orchestrator()
+        with self._patch_scraper("Should Not Scrape") as scraper_mock:
+            b_read = async_to_sync(
+                orchestrator_b._get_or_scrape_website_data
+            )(self.brand_b)
+        scraper_mock.assert_not_called()
+        self.assertEqual(b_read.pk, shared.pk)
+        self.assertIsNone(b_read.brand)
+
+    def test_force_refresh_updates_own_row_in_place(self):
+        owned = BrandWebsiteData.objects.create(
+            identity=self.brand_a.identity,
+            brand=self.brand_a,
+            website_url=self.brand_a.website_url,
+            title="A Before",
+            full_text="before text",
+        )
+        shared = BrandWebsiteData.objects.create(
+            identity=self.brand_a.identity,
+            website_url=self.brand_a.website_url,
+            title="Shared",
+            full_text="shared text",
+        )
+
+        orchestrator = self._orchestrator()
+        with self._patch_scraper("A After") as scraper_mock:
+            result = async_to_sync(orchestrator._get_or_scrape_website_data)(
+                self.brand_a,
+                force_refresh=True,
+            )
+        scraper_mock.assert_called_once()
+
+        # The newest row already belongs to this brand -> updated IN PLACE,
+        # not duplicated, and the shared row is untouched.
+        self.assertEqual(result.pk, owned.pk)
+        self.assertEqual(result.title, "A After")
+        self.assertEqual(
+            BrandWebsiteData.objects.filter(identity=self.brand_a.identity).count(),
+            2,
+        )
+        self.assertEqual(
+            BrandWebsiteData.objects.get(pk=shared.pk).title, "Shared"
+        )
