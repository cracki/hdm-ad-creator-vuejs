+"""
+QA4-MOM closing-gap regression tests (market).
+
+Failing content-intelligence runs must persist (and serve) a GENERIC
+user-safe error message; the real exception goes to the logs only. The
+serializer additionally scrubs internal keys / raw legacy error strings
+from ``result_payload`` before it leaves the API, while keeping the
+business keys the frontend reads (``content_gaps``, ``content_matrix``,
+``content_opportunities``, ``top_performers``, ``hooks`` ...).
+"""
+
+from unittest.mock import patch
+
+from rest_framework import status
+from rest_framework.test import APITestCase
+
+from authentication.models import User
+from brand.models import Brand, Industry
+from market.models import ContentIntelligenceRun
+from market.serializers import (
+    CONTENT_INTELLIGENCE_GENERIC_ERROR,
+    ContentIntelligenceRunSerializer,
+)
+
+GENERIC = CONTENT_INTELLIGENCE_GENERIC_ERROR
+
+
+class FailingRunPersistsGenericErrorTests(APITestCase):
+    """A raised pipeline error must never leak into the stored payload."""
+
+    def setUp(self):
+        self.user = User.objects.create_user(
+            email="market-generic-error@example.com",
+            password="StrongPass123!",
+        )
+        self.client.force_authenticate(user=self.user)
+        self.industry = Industry.objects.create(name="SaaS")
+        self.brand = Brand.objects.create(
+            website_url="https://market-brand.com",
+            company_name="Market Brand",
+            selected_industry=self.industry,
+            created_by=self.user,
+        )
+        self.url = "/api/v1/market/content-intelligence/"
+
+    def test_failing_run_persists_generic_error_message(self):
+        with patch(
+            "market.views.get_full_content_intelligence",
+            side_effect=Exception("SECRET internal traceback leak"),
+        ):
+            response = self.client.post(
+                self.url,
+                {
+                    "brand_uuid": str(self.brand.brand_uuid),
+                    "industry": "SaaS",
+                    "location": "Berlin",
+                },
+                format="json",
+            )
+
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
+
+        run = ContentIntelligenceRun.objects.get(
+            content_intelligence_run_uuid=response.data[
+                "content_intelligence_run_uuid"
+            ]
+        )
+        self.assertEqual(
+            run.status, ContentIntelligenceRun.StatusChoices.FAILED
+        )
+        # Stored payload is generic — no exception text.
+        self.assertEqual(run.result_payload, {"error": GENERIC})
+        self.assertEqual(
+            run.run_type, ContentIntelligenceRun.RunTypeChoices.FULL
+        )
+        self.assertEqual(
+            run.request_payload,
+            {
+                "industry": "SaaS",
+                "location": "Berlin",
+                "brand_services": [],
+                "content_goal": "engagement",
+            },
+        )
+
+        # Serialized payload shows the generic message and nothing internal.
+        self.assertEqual(response.data["result_payload"], {"error": GENERIC})
+        self.assertNotIn("SECRET", str(response.data))
+
+    def test_legacy_raw_error_strings_are_scrubbed_from_api(self):
+        run = ContentIntelligenceRun.objects.create(
+            brand=self.brand,
+            created_by=self.user,
+            run_type=ContentIntelligenceRun.RunTypeChoices.FULL,
+            status=ContentIntelligenceRun.StatusChoices.FAILED,
+            industry="SaaS",
+            location="Berlin",
+            result_payload={
+                "error": "TypeError: cannot read property of undefined",
+                "prompt": "internal prompt",
+                "debug": {"attempt": 3},
+                "content_gaps": {"total_gaps_found": 4},
+            },
+        )
+
+        data = ContentIntelligenceRunSerializer(run).data
+
+        self.assertEqual(
+            data["result_payload"], {"content_gaps": {"total_gaps_found": 4}}
+        )
+
+    def test_generic_error_message_stays_visible_in_api(self):
+        run = ContentIntelligenceRun.objects.create(
+            brand=self.brand,
+            created_by=self.user,
+            run_type=ContentIntelligenceRun.RunTypeChoices.FULL,
+            status=ContentIntelligenceRun.StatusChoices.FAILED,
+            industry="SaaS",
+            location="Berlin",
+            result_payload={"error": GENERIC, "summary_note": "n"},
+        )
+
+        data = ContentIntelligenceRunSerializer(run).data
+
+        self.assertEqual(
+            data["result_payload"], {"error": GENERIC, "summary_note": "n"}
+        )
