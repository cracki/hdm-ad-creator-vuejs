+"""
+QA4-MOM closing-gap regression tests (ad library).
+
+The run list/detail API used to expose the ENTIRE stored generator blob
+(``response_payload``), including internal LLM prompt/debug material. The
+serializer now scrubs internal keys before the payload leaves the API while
+keeping the fields the frontend reads:
+
+- ``response_payload``: business keys (e.g. ``run``, totals) are kept;
+  ``prompt`` / ``system_prompt`` / ``raw`` / ``debug`` / raw error
+  internals are stripped (also nested).
+- ``request_payload`` and ``input_snapshot`` are kept verbatim — the FE
+  detail view reads ``input_snapshot.brand_profile`` and
+  ``request_payload.personas``.
+"""
+
+from rest_framework.test import APITestCase
+
+from ad_library.models import (
+    AdLibraryRun,
+    AdLibraryRunStatusChoices,
+    AdLibraryRunTypeChoices,
+)
+from ad_library.serializers import AdLibraryRunSerializer
+from authentication.models import User
+from brand.models import Brand, Industry
+
+
+class AdLibraryRunPayloadScrubTests(APITestCase):
+    """Internal keys never leave the API; business keys stay intact."""
+
+    def setUp(self):
+        self.user = User.objects.create_user(
+            email="adlib-scrub@example.com",
+            password="StrongPass123!",
+        )
+        self.industry = Industry.objects.create(name="E-Commerce")
+        self.brand = Brand.objects.create(
+            website_url="https://adlib-brand.com",
+            company_name="AdLib Brand",
+            selected_industry=self.industry,
+            created_by=self.user,
+        )
+
+    def _make_run(self, response_payload):
+        return AdLibraryRun.objects.create(
+            brand=self.brand,
+            created_by=self.user,
+            run_type=AdLibraryRunTypeChoices.GENERATE,
+            status=AdLibraryRunStatusChoices.COMPLETED,
+            request_payload={"personas": ["Budget Buyer"]},
+            input_snapshot={"brand_profile": {"industry": "E-Commerce"}},
+            response_payload=response_payload,
+            result_summary={"total_ads": 1},
+        )
+
+    def test_prompt_and_debug_stripped_run_intact(self):
+        run = self._make_run(
+            {
+                "run": [
+                    {
+                        "platform": "meta",
+                        "headline": "Great product",
+                    }
+                ],
+                "prompt": "internal prompt text",
+                "debug": {"attempt": 1},
+            }
+        )
+
+        data = AdLibraryRunSerializer(run).data
+
+        payload = data["response_payload"]
+        self.assertNotIn("prompt", payload)
+        self.assertNotIn("debug", payload)
+        self.assertEqual(
+            payload["run"],
+            [{"platform": "meta", "headline": "Great product"}],
+        )
+
+    def test_internal_keys_stripped_at_any_depth(self):
+        run = self._make_run(
+            {
+                "data": {
+                    "keep": "visible",
+                    "system_prompt": "sys",
+                    "nested": {"prompt": "inner", "raw": "raw", "ok": 1},
+                },
+                "raw_response": '{"model_output": true}',
+                "error_detail": "TypeError: something internal",
+            }
+        )
+
+        data = AdLibraryRunSerializer(run).data
+        payload = data["response_payload"]
+        self.assertEqual(
+            payload,
+            {"data": {"keep": "visible", "nested": {"ok": 1}}},
+        )
+
+    def test_request_payload_and_input_snapshot_untouched(self):
+        # The FE reads request_payload.personas and
+        # input_snapshot.brand_profile on the run detail view.
+        run = self._make_run({"run": [], "prompt": "drop me"})
+
+        data = AdLibraryRunSerializer(run).data
+        self.assertEqual(
+            data["request_payload"], {"personas": ["Budget Buyer"]}
+        )
+        self.assertEqual(
+            data["input_snapshot"],
+            {"brand_profile": {"industry": "E-Commerce"}},
+        )
