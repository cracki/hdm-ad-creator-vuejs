@@ -4,6 +4,54 @@ from rest_framework import serializers
 from ad_library.models import AdLibraryAd, AdLibraryRun
 
 
+# QA4-MOM: keys that must never leave the API from stored payloads —
+# internal LLM prompt/debug material and raw error internals.
+_INTERNAL_PAYLOAD_KEYS = frozenset(
+    {
+        "prompt",
+        "system_prompt",
+        "raw",
+        "raw_response",
+        "raw_output",
+        "debug",
+        "debug_info",
+        "messages",
+        "error_detail",
+        "error_details",
+        "internal_error",
+        "traceback",
+        "exception",
+        "stack_trace",
+    }
+)
+
+
+def strip_internal_payload_keys(value, allowed_error_message=None):
+    """Recursively drop internal keys from a stored JSON payload.
+
+    String values under ``error`` are dropped unless they equal
+    ``allowed_error_message`` (the user-safe generic message), so legacy
+    rows carrying raw exception text never reach the API.
+    """
+    if isinstance(value, dict):
+        cleaned = {}
+        for key, item in value.items():
+            key_lower = str(key).lower()
+            if key_lower in _INTERNAL_PAYLOAD_KEYS:
+                continue
+            if (
+                key_lower == "error"
+                and isinstance(item, str)
+                and item != allowed_error_message
+            ):
+                continue
+            cleaned[key] = strip_internal_payload_keys(item, allowed_error_message)
+        return cleaned
+    if isinstance(value, list):
+        return [strip_internal_payload_keys(item, allowed_error_message) for item in value]
+    return value
+
+
