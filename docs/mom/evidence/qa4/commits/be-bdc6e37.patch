+# QA4-MOM: brand asset uploads are images only (the FE upload inputs use
+# accept="image/*" and the asset analyzer consumes images).
+BRAND_ASSET_ALLOWED_EXTENSIONS = ("png", "jpg", "jpeg", "webp", "svg")
+BRAND_ASSET_ALLOWED_CONTENT_TYPES = (
+    "image/png",
+    "image/jpeg",
+    "image/jpg",
+    "image/pjpeg",
+    "image/webp",
+    "image/svg+xml",
+)
+BRAND_ASSET_MAX_SIZE_BYTES = 5 * 1024 * 1024  # 5 MB
+BRAND_ASSET_MAX_SIZE_MB = 5
+
+
+def website_url_host_is_forbidden(value) -> bool:
+    """QA4-MOM: True for non-public hosts — localhost/loopback, private or
+    link-local IPs (10.x, 172.16-31.x, 192.168.x, 127.x), and ``.local`` /
+    ``.internal`` suffixes. The BrandIdentity normalizer itself stays
+    intact; this only guards what may be ACCEPTED as a brand website URL.
+    """
+    host = (BrandIdentity.normalize_website_url(value or "") or "").split("/")[0]
+    host = host.rsplit("@", 1)[-1]
+    if host.startswith("["):  # IPv6 literal, possibly with port: [::1]:8000
+        closing = host.find("]")
+        host = host[1:closing] if closing != -1 else host[1:]
+    else:
+        host = host.split(":", 1)[0]
+    host = host.strip().strip(".").lower()
+    if not host:
+        return False
+    if host == "localhost" or host.endswith((".localhost", ".local", ".internal")):
+        return True
+    try:
+        ip = ipaddress.ip_address(host)
+    except ValueError:
+        return False
+    return ip.is_loopback or ip.is_private or ip.is_link_local
+
 
