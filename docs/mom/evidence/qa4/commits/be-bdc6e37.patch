+class BrandAssetUploadValidationTests(APITestCase):
+    """QA4-MOM: uploads are type- and size-checked (MOM انجام‌نشده)."""
+
+    def setUp(self):
+        self.user = User.objects.create_user(
+            email="upload-validate@example.com",
+            password="StrongPass123!",
+        )
+        self.industry = Industry.objects.create(name="Retail")
+        self.brand = Brand.objects.create(
+            website_url="https://upload-brand.com",
+            company_name="Upload Brand",
+            selected_industry=self.industry,
+            created_by=self.user,
+        )
+
+    def _serializer(self, uploaded_file):
+        return BrandAssetUploadSerializer(
+            data={
+                "asset_type": "logo",
+                "title": "Logo",
+                "file": uploaded_file,
+            }
+        )
+
+    def test_oversized_file_rejected(self):
+        big = SimpleUploadedFile(
+            "big.png",
+            b"x" * (BRAND_ASSET_MAX_SIZE_BYTES + 1),  # > 5 MB
+            content_type="image/png",
+        )
+        serializer = self._serializer(big)
+        self.assertFalse(serializer.is_valid())
+        self.assertIn("file", serializer.errors)
+        self.assertIn("5 MB", str(serializer.errors["file"]))
+
+    def test_exe_file_rejected(self):
+        exe = SimpleUploadedFile(
+            "installer.exe",
+            b"MZ fake executable",
+            content_type="application/x-msdownload",
+        )
+        serializer = self._serializer(exe)
+        self.assertFalse(serializer.is_valid())
+        self.assertIn("file", serializer.errors)
+        self.assertIn("Unsupported file type", str(serializer.errors["file"]))
+
+    def test_small_png_accepted(self):
+        png = SimpleUploadedFile(
+            "logo.png",
+            b"\x89PNG\r\n\x1a\n" + b"fake-png-bytes" * 10,
+            content_type="image/png",
+        )
+        serializer = self._serializer(png)
+        self.assertTrue(serializer.is_valid(), serializer.errors)
+
+
+class BrandWebsiteUrlHardeningTests(APITestCase):
+    """QA4-MOM: non-public hosts are rejected as brand website_url."""
+
+    def setUp(self):
+        self.user = User.objects.create_user(
+            email="url-hardening@example.com",
+            password="StrongPass123!",
+        )
+        self.industry = Industry.objects.create(name="Hospitality")
+
+    def _validate(self, website_url):
+        serializer = BrandSerializer(
+            data={
+                "website_url": website_url,
+                "company_name": "Hardened Co",
+                "selected_industry_id": self.industry.pk,
+            }
+        )
+        serializer.is_valid()
+        return serializer.errors
+
+    def test_localhost_rejected(self):
+        errors = self._validate("http://localhost:3000")
+        self.assertIn("website_url", errors)
+        self.assertIn(
+            "Local, private, or internal website URLs are not allowed",
+            str(errors["website_url"]),
+        )
+
+    def test_private_and_internal_hosts_rejected(self):
+        for url in (
+            "http://127.0.0.1:8000",
+            "http://192.168.1.10",
+            "http://10.0.0.5",
+            "http://172.16.3.4",
+            "http://mysite.local",
+            "http://mysite.internal",
+        ):
+            with self.subTest(url=url):
+                errors = self._validate(url)
+                self.assertIn("website_url", errors)
+
+    def test_public_url_has_no_website_url_error(self):
+        errors = self._validate("https://public-site.com")
+        self.assertNotIn("website_url", errors)
