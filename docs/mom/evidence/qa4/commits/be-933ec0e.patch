+# QA4-new3: <title>/og:title fallback cleaning helpers.
+_TITLE_SEPARATOR_RE = re.compile(r"\s*[|\u2013\u2014\u00b7-]\s*")
+_SEO_PREAMBLE_RE = re.compile(
+    r"^(?:the\s+)?"
+    r"(?:best|top|no\.?\s*1|leading|professional|trusted|reliable|affordable)\b"
+    r".*?\b(?:in|for)\b\s+",
+    re.IGNORECASE,
+)
+_MARKETING_SUFFIX_RE = re.compile(
+    r"[\s|\u2013\u2014\u00b7-]+\b"
+    r"(?:official\s+(?:site|website)|official|home\s+page|homepage|"
+    r"web\s+site|website|home|online)\s*$",
+    re.IGNORECASE,
+)
+_MULTI_PART_TLD_LABELS = {"com", "co", "org", "net", "gov", "edu"}
+
+
+def _title_tokens(segment: str) -> List[str]:
+    """Lowercase word tokens of a title segment."""
+    return re.findall(r"[a-z0-9]+", str(segment or "").lower())
+
+
+def _registrable_domain_token(value: str) -> str:
+    """Second-level domain label ('https://www.renofit.co.uk/x' -> 'renofit')."""
+    raw = str(value or "").strip().lower()
+    if not raw:
+        return ""
+    host = re.split(r"://", raw)[-1]
+    host = host.split("/", 1)[0].split("?", 1)[0].split(":", 1)[0]
+    host = re.sub(r"^www\.", "", host)
+    labels = [label for label in host.split(".") if label]
+    if len(labels) >= 3 and labels[-2] in _MULTI_PART_TLD_LABELS:
+        labels = labels[:-2]
+    elif len(labels) >= 2:
+        labels = labels[:-1]
+    return labels[-1] if labels else ""
+
+
+def _segment_matches_domain(segment: str, domain_token: str) -> bool:
+    """True when the segment's tokens overlap the registrable domain."""
+    tokens = _title_tokens(segment)
+    if domain_token in tokens:
+        return True
+    # Hyphenated domains ('scan-brand') must match across ALL of their
+    # labels, so a segment containing just 'brand' does not qualify.
+    domain_subtokens = _title_tokens(domain_token)
+    return len(domain_subtokens) > 1 and all(t in tokens for t in domain_subtokens)
+
+
+def _strip_seo_preamble(segment: str) -> str:
+    """Drop a leading SEO preamble ('The Best Salon in Dubai' -> 'Dubai').
+
+    Case-insensitive preamble keywords, but the word following 'in'/'for'
+    must be capitalized (proper noun) — verified outside the regex so
+    re.IGNORECASE cannot weaken it.
+    """
+    text = str(segment or "")
+    match = _SEO_PREAMBLE_RE.match(text)
+    if match and text[match.end() : match.end() + 1].isupper():
+        return text[match.end() :].strip()
+    return text
+
+
+def _strip_marketing_suffixes(segment: str) -> str:
+    """Drop trailing marketing words ('Renofit Official Site' -> 'Renofit')."""
+    cleaned = str(segment or "").strip()
+    for _ in range(3):
+        stripped = _MARKETING_SUFFIX_RE.sub("", cleaned).strip()
+        if stripped == cleaned or not stripped:
+            break
+        cleaned = stripped
+    return cleaned
+
+
