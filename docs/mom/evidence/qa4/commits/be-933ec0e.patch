+    # QA4-new3: Arabic-script characters, including the Arabic Supplement
+    # and Presentation Forms blocks (shaped/precomposed text), used by the
+    # script-ratio heuristic below.
+    _ARABIC_SCRIPT_RE = re.compile(
+        r"[\u0600-\u06FF\u0750-\u077F\uFB50-\uFDFF\uFE70-\uFEFF]"
+    )
+    _LANG_CODE_RE = re.compile(r"^[a-z]{2,3}$")
+
+    @classmethod
+    def _normalize_lang_code(cls, value: str) -> str:
+        """Normalize an HTML lang attribute to its primary subtag.
+
+        'en-US' / 'en_US' -> 'en'; returns '' for missing or malformed
+        values (the attribute must be a 2-3 letter primary subtag).
+        """
+        primary = str(value or "").strip().lower().replace("_", "-").split("-")[0]
+        return primary if cls._LANG_CODE_RE.match(primary) else ""
+
+    def _detect_language(self, text: str, html_lang: str = "") -> str:
+        """Detect text language (QA4-new3).
+
+        1. The ``<html lang>`` attribute is the highest-priority signal and
+           wins outright, so a single localized link/word can no longer flip
+           an English page to 'ar'.
+        2. Otherwise a script-ratio heuristic: 'ar' is reported only when
+           Arabic-script characters make up a meaningful share (>25%) of all
+           letters, replacing the old single-character regex.
+        """
+        normalized_lang = self._normalize_lang_code(html_lang)
+        if normalized_lang:
+            return normalized_lang
+
+        text = text or ""
+        arabic_chars = len(self._ARABIC_SCRIPT_RE.findall(text))
+        if arabic_chars:
+            total_letters = sum(1 for char in text if char.isalpha())
+            if total_letters and arabic_chars / total_letters > 0.25:
+                return "ar"
+
+        if re.search(r"[\u0590-\u05FF]", text):
             return "he"
         elif re.search(r"[\u4e00-\u9fff]", text):
             return "zh"
         return "en"
 
