+    def _clean_title(title: str, domain: str = "") -> str:
+        """Clean a <title>/og:title into a company name (QA4-new3).
+
+        Splits on ``|``, en/em dashes, middle dot and hyphen, then:
+        1. prefers the segment whose tokens overlap the registrable domain
+           (e.g. 'renofit.com' -> segment 'Renofit'), fewest words first;
+        2. otherwise keeps the first segment, stripping leading SEO
+           preambles ('Best ... in Dubai') and trailing marketing suffixes;
+        3. prefers a 1-4 word segment when the cleaned first segment is
+           implausibly long.
+        """
+        segments = [
+            segment.strip()
+            for segment in _TITLE_SEPARATOR_RE.split(str(title or ""))
+            if segment.strip()
+        ]
+        if not segments:
+            return str(title or "").strip()
+
+        domain_token = _registrable_domain_token(domain)
+        if domain_token:
+            matching = [
+                segment
+                for segment in segments
+                if _segment_matches_domain(segment, domain_token)
+            ]
+            if matching:
+                best = min(
+                    matching,
+                    key=lambda segment: (
+                        len(_title_tokens(segment)),
+                        segments.index(segment),
+                    ),
+                )
+                return _strip_marketing_suffixes(best)
+
+        # No domain match: keep the first segment, cleaned.
+        cleaned = _strip_marketing_suffixes(_strip_seo_preamble(segments[0]))
+        if 1 <= len(_title_tokens(cleaned)) <= 4:
+            return cleaned
+        for segment in segments[1:]:
+            candidate = _strip_marketing_suffixes(_strip_seo_preamble(segment))
+            if 1 <= len(_title_tokens(candidate)) <= 4:
+                return candidate
+        return cleaned
 
