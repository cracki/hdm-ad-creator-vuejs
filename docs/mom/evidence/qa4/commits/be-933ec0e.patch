+"""QA4-new3: language / industry / company-name detection fixes.
+
+No network: the real WebsiteScraper and AutoScanEngine detection helpers are
+exercised with synthetic HTML-derived text and arguments only.
+"""
+
+from django.test import TestCase
+
+from brand.engines.auto_scan_engine import AutoScanEngine
+from core.utils.scraper import WebsiteScraper
+
+
+class DetectLanguageTests(TestCase):
+    """Scraper-level _detect_language: html lang first, script ratio second."""
+
+    def setUp(self):
+        self.scraper = WebsiteScraper()
+
+    def test_html_lang_en_wins_over_single_arabic_word(self):
+        # One localized word must not flip an English page to 'ar'.
+        text = "Welcome to our store! \u0645\u0631\u062d\u0628\u0627 shop with us today."
+        self.assertEqual(self.scraper._detect_language(text, "en-US"), "en")
+
+    def test_html_lang_is_normalized_to_primary_subtag(self):
+        self.assertEqual(self.scraper._detect_language("anything", "ar-AE"), "ar")
+        self.assertEqual(self.scraper._detect_language("anything", "en_US"), "en")
+
+    def test_full_arabic_text_without_lang_is_ar(self):
+        text = (
+            "\u0645\u0631\u062d\u0628\u0627 \u0628\u0643\u0645 \u0641\u064a "
+            "\u0645\u0648\u0642\u0639\u0646\u0627 \u0646\u0642\u062f\u0645 "
+            "\u0623\u0641\u0636\u0644 \u0627\u0644\u062e\u062f\u0645\u0627\u062a "
+            "\u0644\u0639\u0645\u0644\u0627\u0626\u0646\u0627 \u0641\u064a "
+            "\u062c\u0645\u064a\u0639 \u0623\u0646\u062d\u0627\u0621 "
+            "\u0627\u0644\u062f\u0648\u0644\u0629"
+        )
+        self.assertEqual(self.scraper._detect_language(text), "ar")
+
+    def test_small_arabic_share_in_english_is_en(self):
+        # Roughly 5% Arabic-script letters in a predominantly English page:
+        # 5 Arabic letters vs 97 Latin letters -> 4.9%, far below the 25%
+        # threshold, so a localized phrase must not flip the page to 'ar'.
+        english = (
+            "Welcome to our cleaning company in Dubai. We provide deep "
+            "cleaning, AC cleaning and handyman services across the city. "
+        )
+        self.assertEqual(
+            self.scraper._detect_language(english + "\u062e\u062f\u0645\u0627\u062a"),
+            "en",
+        )
+
+
+class EngineLanguagePrecedenceTests(TestCase):
+    """auto_scan_engine language chain: html_lang > og:locale > content."""
+
+    def setUp(self):
+        self.engine = AutoScanEngine()
+
+    def test_html_lang_is_highest_priority(self):
+        result = self.engine._detect_language(
+            {"html_lang": "en", "og_data": {"locale": "ar_AE"}, "language": "ar"}
+        )
+        self.assertEqual(result, {"value": "en", "confidence": "high", "source": "html_lang"})
+
+    def test_og_locale_beats_content_heuristic(self):
+        result = self.engine._detect_language(
+            {"html_lang": "", "og_data": {"locale": "ar_AE"}, "language": "en"}
+        )
+        self.assertEqual(result["value"], "ar")
+        self.assertEqual(result["source"], "og:locale")
+
+    def test_content_heuristic_is_demoted_to_low(self):
+        result = self.engine._detect_language({"language": "ar"})
+        self.assertEqual(result["confidence"], "low")
+        self.assertEqual(result["source"], "content_analysis")
+
+
+class IndustryScoringTests(TestCase):
+    """Scraper-level whole-word keyword scoring + home_services category."""
+
+    def setUp(self):
+        self.scraper = WebsiteScraper()
+
+    def test_spa_does_not_match_inside_storage_space(self):
+        scores = self.scraper._score_industries(
+            ["Storage Space Prices"],
+            "Compare storage space prices in Dubai. Book your storage unit online today.",
+        )
+        self.assertNotIn("beauty", scores)
+        self.assertEqual(scores, {})
+
+    def test_cleaning_page_scores_home_services(self):
+        scores = self.scraper._score_industries(
+            ["AC Cleaning & Deep Cleaning Services"],
+            "We provide air conditioning cleaning, handyman repairs, plumbing "
+            "and electrician visits. Book pest control, painting or carpentry "
+            "experts, or renovation and refurbishment maintenance for your home.",
+        )
+        self.assertIn("home_services", scores)
+        self.assertEqual(max(scores, key=scores.get), "home_services")
+        # The category key maps to the human-readable industry name the
+        # engine matches against Industry rows ('Home Services').
+        self.assertEqual(
+            self.scraper._detect_industry(
+                ["AC Cleaning & Deep Cleaning Services"],
+                "air conditioning cleaning handyman plumbing renovation",
+            ),
+            "Home Services",
+        )
+
+
+class IndustryConfidenceTests(TestCase):
+    """'high' only when the top score is >= 2 and leads the runner-up by >= 2."""
+
+    def test_decisive_scores_are_strong(self):
+        # Top 3 vs runner-up 1.
+        self.assertTrue(
+            AutoScanEngine._industry_scores_are_strong(
+                {"industry_scores": {"beauty": 3, "healthcare": 1}}
+            )
+        )
+        self.assertFalse(
+            AutoScanEngine._industry_scores_are_strong(
+                {"industry_scores": {"beauty": 2, "healthcare": 1}}
+            )
+        )
+        self.assertFalse(
+            AutoScanEngine._industry_scores_are_strong(
+                {"industry_scores": {"beauty": 1}}
+            )
+        )
+        self.assertFalse(AutoScanEngine._industry_scores_are_strong({}))
+
+    def test_exact_match_is_high_only_when_decisive(self):
+        engine = AutoScanEngine()
+        industries = [{"industry_uuid": "u1", "name": "Home Services"}]
+        base = {
+            "detected_industry": "Home Services",
+            "title": "",
+            "og_data": {},
+            "audience_signals": {},
+        }
+
+        strong = dict(base, industry_scores={"home_services": 3, "real_estate": 1})
+        candidates = engine._detect_industry_candidates(strong, industries)
+        self.assertEqual(candidates[0]["confidence"], "high")
+        self.assertEqual(candidates[0]["source"], "detected_industry")
+
+        weak = dict(base, industry_scores={"home_services": 1})
+        candidates = engine._detect_industry_candidates(weak, industries)
+        self.assertEqual(candidates[0]["confidence"], "medium")
+
+
+class CleanTitleTests(TestCase):
+    """Title-tag fallback: domain segment preference + SEO preamble stripping."""
+
+    def test_domain_match_selects_brand_segment_after_pipe(self):
+        self.assertEqual(
+            AutoScanEngine._clean_title("Renovation company in Dubai | Renofit", "renofit.com"),
+            "Renofit",
+        )
+
+    def test_domain_match_selects_segment_before_dash(self):
+        self.assertEqual(
+            AutoScanEngine._clean_title("Justlife - Home Services", "justlife.com"),
+            "Justlife",
+        )
+
+    def test_no_domain_match_keeps_first_segment(self):
+        self.assertEqual(
