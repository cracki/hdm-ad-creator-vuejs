diff --git a/django-backend/core/exception_handler.py b/django-backend/core/exception_handler.py
new file mode 100644
index 0000000..2c1e7da
--- /dev/null
+++ b/django-backend/core/exception_handler.py
@@ -0,0 +1,56 @@
+"""
+Shared DRF exception handler (QA4 MOM item).
+
+DRF renders ``ValidationError("some message")`` as a bare JSON array body
+(``["some message"]``) and ``ValidationError(["a", "b"])`` as a bare list
+body. Frontends that read ``data.detail`` then fall back to a generic
+error message, losing the real reason.
+
+This handler normalizes ONLY those confusing bare string/list bodies into
+``{"detail": ...}`` objects while leaving everything else untouched:
+
+- ``None`` responses (non-API exceptions) pass through so Django's
+  standard 500 handling proceeds unchanged.
+- Dict payloads (field errors like ``{"website_url": ["..."]}`` and
+  bodies that already carry ``detail``) are kept exactly as-is.
+- Status codes are preserved.
+
+Wire it in ``configuration/settings.py`` via::
+
+    REST_FRAMEWORK = {
+        ...,
+        "EXCEPTION_HANDLER": "core.exception_handler.qa_exception_handler",
+    }
+"""
+
+from rest_framework.views import exception_handler as drf_exception_handler
+
+
+def _as_detail_value(data):
+    """Collapse a bare string/list body into a single ``detail`` value."""
+    if isinstance(data, str):
+        return data
+    if isinstance(data, (list, tuple)):
+        if data and all(isinstance(item, str) for item in data):
+            return "; ".join(str(item) for item in data)
+        # Structured list (e.g. per-item errors from many=True
+        # serializers): keep the items intact, just move them under
+        # `detail` so no information is lost.
+        return list(data)
+    return data
+
+
+def qa_exception_handler(exc, context):
+    response = drf_exception_handler(exc, context)
+    if response is None:
+        # Not a DRF-handled API exception: defer to Django's 500 path.
+        return None
+
+    if isinstance(response.data, dict):
+        # Field-error payloads ({"website_url": ["..."]}) and bodies that
+        # already carry `detail` stay as-is; only bare string/list bodies
+        # are confusing to the frontend.
+        return response
+
+    response.data = {"detail": _as_detail_value(response.data)}
+    return response
