+"""
+QA4 regression tests:
+
+- QA4-new1: ``BrandSerializer.has_completed_analysis`` stays True even when
+  the NEWEST analysis run is queued/failed, while ``analysis_status``
+  keeps reflecting the newest run.
+- QA4-N1: auto-scan failures return ``{"detail": "..."}`` object bodies
+  (not the bare JSON array DRF produces for plain-string ValidationErrors).
+- MOM item: ``core.exception_handler.qa_exception_handler`` normalizes bare
+  string/list DRF error bodies to ``{"detail": ...}`` and keeps field-error
+  dicts intact.
+"""
+
+from datetime import timedelta
+from unittest.mock import patch
+
+from django.test import SimpleTestCase
+from django.urls import reverse
+from django.utils import timezone
+from rest_framework import status
+from rest_framework.exceptions import ValidationError
+from rest_framework.test import APITestCase
+
+from authentication.models import User
+from brand.models import Brand, BrandAnalysisRun, Industry
+from brand.serializers import BrandSerializer
+from brand.services.auto_scan import AutoScanError, BrandAutoScanService
+from core.exception_handler import qa_exception_handler
+
+
+def _make_brand(created_by, name, url):
+    industry = Industry.objects.create(name=f"{name} Industry")
+    return Brand.objects.create(
+        website_url=url,
+        company_name=name,
+        selected_industry=industry,
+        created_by=created_by,
+    )
+
+
+def _make_run(brand, status_value, minutes_ago=0):
+    run = BrandAnalysisRun.objects.create(brand=brand, status=status_value)
+    if minutes_ago:
+        # created_at is auto_now_add, so pin it via queryset update to make
+        # the "newest run" ordering deterministic regardless of clock
+        # resolution (ordering is -created_at, -pk).
+        BrandAnalysisRun.objects.filter(pk=run.pk).update(
+            created_at=timezone.now() - timedelta(minutes=minutes_ago)
+        )
+    return run
+
+
+class HasCompletedAnalysisSerializerTests(APITestCase):
+    """QA4-new1: a newer queued/failed run must not hide a completed analysis."""
+
+    def setUp(self):
+        self.user = User.objects.create_user(
+            email="has-completed@example.com",
+            password="StrongPass123!",
+        )
+
+    def _serialize(self, brand):
+        return BrandSerializer(brand).data
+
+    def test_no_runs_means_false(self):
+        brand = _make_brand(
+            self.user, "No Runs Co", "https://no-runs.example.com"
+        )
+        data = self._serialize(brand)
+        self.assertFalse(data["has_completed_analysis"])
+        self.assertEqual(data["analysis_status"], "none")
+
+    def test_completed_run_means_true(self):
+        brand = _make_brand(
+            self.user, "Completed Co", "https://completed.example.com"
+        )
+        _make_run(
+            brand, BrandAnalysisRun.StatusChoices.COMPLETED, minutes_ago=5
+        )
+        data = self._serialize(brand)
+        self.assertTrue(data["has_completed_analysis"])
+        self.assertEqual(data["analysis_status"], "completed")
+
+    def test_newer_failed_run_hides_status_but_not_completed_flag(self):
+        brand = _make_brand(self.user, "Failed Co", "https://failed.example.com")
+        _make_run(
+            brand, BrandAnalysisRun.StatusChoices.COMPLETED, minutes_ago=30
+        )
+        _make_run(brand, BrandAnalysisRun.StatusChoices.FAILED, minutes_ago=1)
+
+        data = self._serialize(brand)
+        self.assertTrue(data["has_completed_analysis"])
+        # analysis_status still reflects the newest (failed) run.
+        self.assertEqual(data["analysis_status"], "failed")
+
+    def test_newer_pending_run_hides_status_but_not_completed_flag(self):
+        brand = _make_brand(
+            self.user, "Pending Co", "https://pending.example.com"
+        )
+        _make_run(
+            brand, BrandAnalysisRun.StatusChoices.COMPLETED, minutes_ago=30
+        )
+        _make_run(brand, BrandAnalysisRun.StatusChoices.PENDING, minutes_ago=1)
+
+        data = self._serialize(brand)
+        self.assertTrue(data["has_completed_analysis"])
+        self.assertEqual(data["analysis_status"], "pending")
+
+    def test_only_failed_run_means_false(self):
+        brand = _make_brand(
+            self.user, "Only Failed Co", "https://only-failed.example.com"
+        )
+        _make_run(brand, BrandAnalysisRun.StatusChoices.FAILED, minutes_ago=5)
+        data = self._serialize(brand)
+        self.assertFalse(data["has_completed_analysis"])
+        self.assertEqual(data["analysis_status"], "failed")
+
+    def test_list_endpoint_exposes_field(self):
+        brand = _make_brand(self.user, "List Co", "https://list.example.com")
+        _make_run(
+            brand, BrandAnalysisRun.StatusChoices.COMPLETED, minutes_ago=5
+        )
+        _make_run(brand, BrandAnalysisRun.StatusChoices.PENDING, minutes_ago=1)
+
+        self.client.force_authenticate(user=self.user)
+        response = self.client.get(reverse("brand-list"))
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
+
+        results = (
+            response.data["results"]
+            if isinstance(response.data, dict) and "results" in response.data
+            else response.data
+        )
+        row = next(
+            item
+            for item in results
+            if item["brand_uuid"] == str(brand.brand_uuid)
+        )
+        self.assertTrue(row["has_completed_analysis"])
+        self.assertEqual(row["analysis_status"], "pending")
+
+
+class BrandAutoScanErrorBodyTests(APITestCase):
+    """QA4-N1: scan errors must produce a {"detail": ...} body."""
+
+    def setUp(self):
+        self.user = User.objects.create_user(
+            email="scan-error@example.com",
+            password="StrongPass123!",
+        )
+        self.client.force_authenticate(user=self.user)
+        self.scan_url = reverse("brand-auto-scan")
+
+    def test_auto_scan_error_returns_detail_object(self):
+        with patch.object(
+            BrandAutoScanService,
+            "run_auto_scan",
+            side_effect=AutoScanError(
+                "The website responded with HTTP 404; the page could not be scanned."
+            ),
+        ):
+            response = self.client.post(
+                self.scan_url,
+                {"website_url": "https://example.com"},
+                format="json",
+            )
+
+        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
+        # Body must be an object with `detail`, not a bare JSON array.
+        self.assertIsInstance(response.data, dict)
+        self.assertIn("detail", response.data)
+        self.assertIn("HTTP 404", str(response.data["detail"]))
+
+    def test_auto_scan_happy_path_unaffected(self):
+        payload = {"success": True, "detected": {}, "warnings": []}
+        with patch.object(
+            BrandAutoScanService,
+            "run_auto_scan",
+            return_value=payload,
+        ):
+            response = self.client.post(
+                self.scan_url,
+                {"website_url": "https://example.com"},
+                format="json",
+            )
+
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
+        self.assertEqual(response.data, payload)
+
+
+class QAExceptionHandlerTests(SimpleTestCase):
+    """Unit tests for the shared exception handler (MOM item)."""
+
+    @staticmethod
+    def _context():
+        return {"view": None, "request": None, "args": (), "kwargs": {}}
+
+    def test_bare_string_validation_error_becomes_detail(self):
+        response = qa_exception_handler(
+            ValidationError("plain"), self._context()
+        )
+        self.assertIsNotNone(response)
+        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
+        self.assertEqual(response.data, {"detail": "plain"})
+
+    def test_bare_list_validation_error_becomes_joined_detail(self):
+        response = qa_exception_handler(
+            ValidationError(["first problem", "second problem"]),
+            self._context(),
+        )
+        self.assertIsNotNone(response)
+        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
+        self.assertEqual(
+            response.data, {"detail": "first problem; second problem"}
+        )
+
+    def test_field_error_dict_is_preserved(self):
+        response = qa_exception_handler(
+            ValidationError({"website_url": ["bad"]}), self._context()
+        )
+        self.assertIsNotNone(response)
+        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
+        self.assertEqual(response.data, {"website_url": ["bad"]})
+
+    def test_non_api_exception_returns_none(self):
+        self.assertIsNone(
+            qa_exception_handler(ValueError("boom"), self._context())
+        )
