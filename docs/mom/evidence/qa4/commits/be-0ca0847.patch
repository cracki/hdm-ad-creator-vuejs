+@api_view(["GET"])
+@permission_classes([IsAuthenticated])
+def credits_summary_view(request):
+    """Report the authenticated user's token usage for the current month.
+
+    Returns ``{"used_month": int, "quota_month": int | None}`` where
+    ``used_month`` is the sum of this user's ``TokenUsage.total_tokens``
+    for the current calendar month (0 when there are no rows) and
+    ``quota_month`` comes from the AI_MONTHLY_TOKEN_QUOTA env var.
