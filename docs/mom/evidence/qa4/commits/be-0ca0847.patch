diff --git a/django-backend/core/tests_credits.py b/django-backend/core/tests_credits.py
new file mode 100644
index 0000000..1acbc4a
--- /dev/null
+++ b/django-backend/core/tests_credits.py
@@ -0,0 +1,249 @@
+"""Tests for AI-usage tracking (AI Credits, MOM §17.2/17.3).
+
+Covers:
+- TokenUsage persistence from LLMHandler chat/vision calls (mocked OpenAI
+  client at the boundary the handler uses: ``openai_client.chat
+  .completions.create``).
+- Middleware ContextVar attribution of usage rows to the requesting user.
+- GET /api/v1/credits/summary/ (auth required, month scoping, quota env).
+- Logging-write failures never break the LLM call itself.
+"""
+
+import os
+from datetime import timedelta
+from types import SimpleNamespace
+from unittest import mock
+
+from asgiref.sync import async_to_sync
+from django.contrib.auth import get_user_model
+from django.http import HttpResponse
+from django.test import RequestFactory, TestCase
+from django.urls import reverse
+from django.utils import timezone
+from rest_framework import status
+from rest_framework.test import APIClient
+
+from core.middleware import (
+    CurrentUserMiddleware,
+    current_user_id,
+    get_current_user_id,
+)
+from core.models import TokenUsage
+from core.services.llm_handler import LLMHandler
+
+User = get_user_model()
+
+FAKE_USAGE = {
+    "prompt_tokens": 100,
+    "completion_tokens": 50,
+    "total_tokens": 150,
+}
+
+
+def make_fake_response(content='{"ok": true}'):
+    return SimpleNamespace(
+        choices=[SimpleNamespace(message=SimpleNamespace(content=content))],
+        usage=SimpleNamespace(**FAKE_USAGE),
+    )
+
+
+def make_handler() -> LLMHandler:
+    """Build an LLMHandler whose OpenAI client is mocked at the boundary."""
+    with mock.patch.dict(os.environ, {"OPENAI_API_KEY": "test-key"}):
+        handler = LLMHandler()
+    handler.openai_client = mock.MagicMock()
+    handler.openai_client.chat.completions.create = mock.AsyncMock(
+        return_value=make_fake_response()
+    )
+    return handler
+
+
+def run_llm(coro):
+    """Run a handler coroutine the way production ASGI does.
+
+    ``async_to_sync`` keeps thread-sensitive sync work — the TokenUsage ORM
+    write performed via the handler's ``sync_to_async`` fallback — on the
+    calling thread, so the row joins the TestCase transaction and is rolled
+    back with it. (Bare ``asyncio.run()`` would hand the coroutine its own
+    DB connection, breaking transactional isolation.) The coroutine runs
+    without DJANGO_ALLOW_ASYNC_UNSAFE so the same SynchronousOnlyOperation
+    -> sync_to_async fallback used in production ASGI is exercised here.
+    """
+    with mock.patch.dict(os.environ, clear=False):
+        os.environ.pop("DJANGO_ALLOW_ASYNC_UNSAFE", None)
+        return async_to_sync(lambda: coro)()
+
+
+class LLMHandlerTokenUsageTests(TestCase):
+    """(a) TokenUsage rows persisted from mocked LLM calls."""
+
+    def test_chat_call_persists_exactly_one_row(self):
+        handler = make_handler()
+
+        result = run_llm(handler._call_llm("hello", system_message="sys"))
+
+        self.assertEqual(result["tokens"], FAKE_USAGE["total_tokens"])
+        self.assertEqual(TokenUsage.objects.count(), 1)
+        row = TokenUsage.objects.get()
+        self.assertEqual(row.prompt_tokens, FAKE_USAGE["prompt_tokens"])
+        self.assertEqual(row.completion_tokens, FAKE_USAGE["completion_tokens"])
+        self.assertEqual(row.total_tokens, FAKE_USAGE["total_tokens"])
+        self.assertEqual(row.model_name, handler.openai_model)
+        self.assertEqual(row.feature, "")
+        self.assertEqual(row.meta, {})
+        self.assertIsNone(row.user)  # no request context -> anonymous row
+
+    def test_vision_call_persists_with_vision_model_name(self):
+        handler = make_handler()
+
+        run_llm(
+            handler.analyze_image_json(
+                prompt="describe",
+                image_bytes=b"fake-image-bytes",
+                filename="photo.jpg",
+            )
+        )
+
+        self.assertEqual(TokenUsage.objects.count(), 1)
+        row = TokenUsage.objects.get()
+        self.assertEqual(row.model_name, handler.openai_vision_model)
+        self.assertEqual(row.total_tokens, FAKE_USAGE["total_tokens"])
+        self.assertEqual(row.prompt_tokens, FAKE_USAGE["prompt_tokens"])
+
+    def test_with_feature_labels_recorded_row(self):
+        handler = make_handler()
+
+        with handler.with_feature("brand_analysis"):
+            run_llm(handler._call_llm("hello"))
+
+        row = TokenUsage.objects.get()
+        self.assertEqual(row.feature, "brand_analysis")
+
+    def test_with_feature_restores_previous_label(self):
+        handler = make_handler()
+        handler.feature_label = "outer"
+
+        with handler.with_feature("inner"):
+            self.assertEqual(handler.feature_label, "inner")
+        self.assertEqual(handler.feature_label, "outer")
+
+
+class CurrentUserMiddlewareTests(TestCase):
+    """(b) Middleware ContextVar binding and usage attribution."""
+
+    def setUp(self):
+        self.user = User.objects.create_user(
+            email="middleware@example.com", password="pw-123456!"
+        )
+
+    def test_middleware_sets_user_id_during_request_and_resets_after(self):
+        captured = {}
+
+        def get_response(request):
+            captured["user_id"] = get_current_user_id()
+            return HttpResponse("ok")
+
+        request = RequestFactory().get("/health/")
+        request.user = self.user
+        CurrentUserMiddleware(get_response)(request)
+
+        self.assertEqual(captured["user_id"], self.user.pk)
+        self.assertIsNone(get_current_user_id())  # reset in finally
+
+    def test_anonymous_request_does_not_bind_contextvar(self):
+        from django.contrib.auth.models import AnonymousUser
+
+        captured = {}
+
+        def get_response(request):
+            captured["user_id"] = get_current_user_id()
+            return HttpResponse("ok")
+
+        request = RequestFactory().get("/health/")
+        request.user = AnonymousUser()
+        CurrentUserMiddleware(get_response)(request)
+
+        self.assertIsNone(captured["user_id"])
+
+    def test_contextvar_attributes_token_usage_row_to_user(self):
+        handler = make_handler()
+        token = current_user_id.set(self.user.pk)
+        try:
+            run_llm(handler._call_llm("hello"))
+        finally:
+            current_user_id.reset(token)
+
+        row = TokenUsage.objects.get()
+        self.assertEqual(row.user, self.user)
+        self.assertEqual(row.user_id, self.user.pk)
+
+
+class CreditsSummaryViewTests(TestCase):
+    """(c) GET /api/v1/credits/summary/ behaviour."""
+
+    def setUp(self):
+        self.client = APIClient()
+        self.user = User.objects.create_user(
+            email="credits@example.com", password="pw-123456!"
+        )
+        self.other_user = User.objects.create_user(
+            email="other@example.com", password="pw-123456!"
+        )
+        self.url = reverse("credits-summary")
+
+    def _seed(self, user, total_tokens, days_ago=0):
+        row = TokenUsage.objects.create(
+            user=user,
+            total_tokens=total_tokens,
+            prompt_tokens=total_tokens,
+            model_name="gpt-4.1-mini",
+            feature="test",
+        )
+        if days_ago:
+            TokenUsage.objects.filter(pk=row.pk).update(
+                created_at=timezone.now() - timedelta(days=days_ago)
+            )
+        return row
+
+    def test_url_resolves_to_api_contract_path(self):
+        self.assertEqual(self.url, "/api/v1/credits/summary/")
+
+    def test_requires_authentication(self):
+        response = self.client.get(self.url)
+        self.assertIn(
+            response.status_code,
+            (status.HTTP_401_UNAUTHORIZED, status.HTTP_403_FORBIDDEN),
+        )
+
+    def test_used_month_sums_only_current_month_rows_of_this_user(self):
+        self._seed(self.user, 150)
+        self._seed(self.user, 250)
+        self._seed(self.other_user, 9999)  # another user's usage
+        self._seed(self.user, 1000, days_ago=40)  # last month's usage
+
+        self.client.force_authenticate(self.user)
+        with mock.patch.dict(os.environ, {"AI_MONTHLY_TOKEN_QUOTA": "25000"}):
+            response = self.client.get(self.url)
+
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
+        self.assertEqual(response.data["used_month"], 400)
+        self.assertEqual(response.data["quota_month"], 25000)
+
+    def test_used_month_is_zero_without_rows(self):
+        self.client.force_authenticate(self.user)
+        env = {k: v for k, v in os.environ.items() if k != "AI_MONTHLY_TOKEN_QUOTA"}
+        with mock.patch.dict(os.environ, env, clear=True):
+            response = self.client.get(self.url)
+
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
+        self.assertEqual(response.data["used_month"], 0)
+        self.assertIsNone(response.data["quota_month"])
+
+
+class HealthViewTests(TestCase):
+    """health_view must stay public despite the IsAuthenticated default."""
+
+    def test_health_view_allows_anonymous(self):
+        response = self.client.get(reverse("health"))
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
+        self.assertEqual(response.data, "OK")
