+def _monthly_quota_from_env() -> Optional[int]:
+    """Read AI_MONTHLY_TOKEN_QUOTA at request time; None when unset/invalid."""
+    raw = os.getenv("AI_MONTHLY_TOKEN_QUOTA")
+    if not raw:
+        return None
+    try:
+        return int(raw)
+    except (TypeError, ValueError):
+        return None
+
