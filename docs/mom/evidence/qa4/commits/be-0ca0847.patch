diff --git a/django-backend/core/middleware.py b/django-backend/core/middleware.py
new file mode 100644
index 0000000..e2bd7eb
--- /dev/null
+++ b/django-backend/core/middleware.py
@@ -0,0 +1,51 @@
+"""Request-scoped user attribution via a ContextVar.
+
+Non-request-scoped code (async LLM calls inside
+``core.services.llm_handler.LLMHandler``) cannot receive ``request.user``
+directly, so :class:`CurrentUserMiddleware` binds the authenticated user's
+primary key to a module-level ContextVar for the duration of each request.
+Helpers elsewhere read it back with :func:`get_current_user_id` — e.g. to
+attribute ``TokenUsage`` rows to the right user.
+
+The ContextVar default is ``None`` (no user / background job context).
+"""
+
+from contextvars import ContextVar
+from typing import Any, Optional
+
+from django.http import HttpRequest, HttpResponse
+
+#: Holds the ``pk`` of the authenticated user for the current request.
+current_user_id: ContextVar[Optional[Any]] = ContextVar(
+    "current_user_id",
+    default=None,
+)
+
+
+def get_current_user_id() -> Optional[Any]:
+    """Return the pk of the user bound to the current request, or ``None``."""
+    return current_user_id.get()
+
+
+class CurrentUserMiddleware:
+    """Store ``request.user.pk`` in a ContextVar for non-request-scoped code.
+
+    Must run after ``django.contrib.auth.middleware.AuthenticationMiddleware``
+    (it is last in ``MIDDLEWARE``) so that ``request.user`` is already
+    resolved. The binding is always reset in ``finally`` so a long-lived
+    worker thread never leaks a previous request's user.
+    """
+
+    def __init__(self, get_response):
+        self.get_response = get_response
+
+    def __call__(self, request: HttpRequest) -> HttpResponse:
+        token = None
+        user = getattr(request, "user", None)
+        if getattr(user, "is_authenticated", False):
+            token = current_user_id.set(user.pk)
+        try:
+            return self.get_response(request)
+        finally:
+            if token is not None:
+                current_user_id.reset(token)
