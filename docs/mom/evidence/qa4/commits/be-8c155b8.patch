+class FunnelAITextTierTests(SimpleTestCase):
+    """AI tier (QA4-img15): one batched JSON call per persona (capped at
+    four per build) overrides headline_angle/body_approach for all three
+    stages; any failure or malformed JSON falls back without raising.
+    """
+
+    def setUp(self):
+        env = patch.dict(
+            os.environ,
+            {"OPENAI_API_KEY": "test-key", FUNNEL_AI_TEXT_ENV: "1"},
+        )
+        env.start()
+        self.addCleanup(env.stop)
+        self.engine = SmartFunnelEngine()
+
+    @staticmethod
+    def _ai_content(name):
+        return json.dumps(
+            {
+                "tofu": {
+                    "headline_angle": f"AI TOFU angle for {name}",
+                    "body_approach": f"AI TOFU body about Pricing confusion for {name}",
+                },
+                "mofu": {
+                    "headline_angle": f"AI MOFU angle for {name}",
+                    "body_approach": f"AI MOFU body comparing options against Pricing confusion for {name}",
+                },
+                "bofu": {
+                    "headline_angle": f"AI BOFU angle for {name}",
+                    "body_approach": f"AI BOFU body closing {name} today despite Pricing confusion",
+                },
+            }
+        )
+
+    def test_ai_texts_override_all_three_stages_and_prompt_names_the_pain(self):
+        payload = json.loads(self._ai_content("Solo Stella"))
+        llm_mock = AsyncMock(return_value={"content": json.dumps(payload)})
+        with patch.object(self.engine.llm_handler, "_call_llm", llm_mock):
+            result = asyncio.run(
+                self.engine.generate_funnel_context([PERSONA_STELLA], [])
+            )
+
+        self.assertTrue(result["success"])
+        profile = result["funnel_context"]["persona_profiles"][0]
+        for stage in ("tofu", "mofu", "bofu"):
+            message = profile["messages"][stage]
+            self.assertEqual(
+                message["headline_angle"], payload[stage]["headline_angle"]
+            )
+            self.assertEqual(
+                message["body_approach"], payload[stage]["body_approach"]
+            )
+            # The AI text carries the persona's own pain from the prompt.
+            self.assertIn("Pricing confusion", message["body_approach"])
+
+        # Exactly ONE batched call per persona covers all three stages.
+        self.assertEqual(llm_mock.await_count, 1)
+        prompt = llm_mock.call_args.kwargs["prompt"]
+        self.assertIn("Solo Stella", prompt)
+        self.assertIn("Pricing confusion", prompt)
+
+    def test_ai_makes_one_call_per_persona_and_caps_at_four(self):
+        roster = [
+            _persona_variant(PERSONA_STELLA, f"Persona {index}", "Pricing confusion")
+            for index in range(4)
+        ]
+        fifth = _persona_variant(PERSONA_STELLA, "Persona 4", "Slow invoicing")
+        roster.append(fifth)
+
+        llm_mock = AsyncMock(
+            return_value={"content": self._ai_content("Solo Stella")}
+        )
+        with patch.object(self.engine.llm_handler, "_call_llm", llm_mock):
+            result = asyncio.run(
+                self.engine.generate_funnel_context(roster, [])
+            )
+
+        # One call per persona, hard-capped at four per funnel build.
+        self.assertEqual(llm_mock.await_count, 4)
+        profiles = result["funnel_context"]["persona_profiles"]
+        for index in range(4):
+            self.assertEqual(
+                profiles[index]["messages"]["tofu"]["body_approach"],
+                "AI TOFU body about Pricing confusion for Solo Stella",
+            )
+        # Persona 5 is over the cap: deterministic template tier, seeded
+        # with her own pain, not the mocked AI text.
+        fifth_body = profiles[4]["messages"]["tofu"]["body_approach"]
+        self.assertNotIn("AI TOFU body", fifth_body)
+        self.assertIn("Slow invoicing", fifth_body)
