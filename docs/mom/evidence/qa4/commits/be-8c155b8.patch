+"""QA4-img15 regression tests: per-persona funnel stage texts.
+
+The smart-funnel engine used to hand every persona the identical template
+sentence per stage ("Storytelling that connects with ...", "Features vs
+benefits with social proof ...", "Clear value proposition with risk
+reversal ..."). These tests pin the two-tier replacement:
+
+- Deterministic tier (FUNNEL_AI_TEXT=0, over the per-build AI cap, or any
+  AI failure): four DISTINCT per-stage body-approach templates rotated by
+  persona index, each seeded with the persona's own pain/fear/goal.
+- AI tier (FUNNEL_AI_TEXT=1, the default): ONE batched JSON call per
+  persona whose headline_angle/body_approach override the deterministic
+  text, with graceful fallback on any failure.
+
+Only the deterministic tier runs in these tests' fallback cases because the
+LLM key is a dummy: the handler call fails (or is mocked) and the engine
+falls back without raising.
+"""
+
+import asyncio
+import json
+import os
+from dataclasses import asdict
+from itertools import combinations
+from unittest.mock import AsyncMock, patch
+
+from django.test import SimpleTestCase
+
+from campaign.engines.smart_funnel_engine import (
+    FUNNEL_AI_TEXT_ENV,
+    FunnelStage,
+    SmartFunnelEngine,
+)
+
+# Substrings of the three retired one-size-fits-all sentences (QA4-img15).
+OLD_TOFU_SENTENCE = "Storytelling that connects with"
+OLD_MOFU_SENTENCE = "Features vs benefits with social proof"
+OLD_BOFU_SENTENCE = "Clear value proposition with risk reversal"
+OLD_SENTENCE_MARKERS = (OLD_TOFU_SENTENCE, OLD_MOFU_SENTENCE, OLD_BOFU_SENTENCE)
+
+PERSONA_STELLA = {
+    "persona_name": "Solo Stella",
+    "goals_motivations": {
+        "primary_goal": "Book more clients without discounting",
+        "secondary_goals": ["Look professional online"],
+        "fears_anti_goals": ["Wasting evenings on admin"],
+    },
+    "pain_points": {
+        "emotional_pains": ["Pricing confusion"],
+        "functional_pains": ["Quotes take hours to write"],
+    },
+    "behavioral_traits": {
+        "purchasing_behavior": "does heavy research",
+        "brand_loyalty": "low",
+    },
+}
+
+PERSONA_MARCUS = {
+    "persona_name": "Ops Marcus",
+    "goals_motivations": {
+        "primary_goal": "Keep every job on schedule",
+        "secondary_goals": ["Cut paperwork for the crew"],
+        "fears_anti_goals": ["Losing repeat customers"],
+    },
+    "pain_points": {
+        "emotional_pains": ["Chaos when jobs overlap"],
+        "functional_pains": ["Double data entry"],
+    },
+    "behavioral_traits": {
+        "purchasing_behavior": "quick decisive buyer",
+        "brand_loyalty": "high",
+    },
+}
+
+
+def _persona_variant(base, name, pain):
+    persona = json.loads(json.dumps(base))
+    persona["persona_name"] = name
+    persona["pain_points"]["emotional_pains"] = [pain]
+    return persona
+
+
+class FunnelFallbackPersonaTextTests(SimpleTestCase):
+    """Deterministic tier (QA4-img15): with the AI text tier switched off,
+    the engine must rotate four DISTINCT per-stage templates seeded with
+    each persona's own pains/fears/goals — never the three old shared
+    sentences.
+    """
+
+    def setUp(self):
+        env = patch.dict(
+            os.environ,
+            {"OPENAI_API_KEY": "test-key", FUNNEL_AI_TEXT_ENV: "0"},
+        )
+        env.start()
+        self.addCleanup(env.stop)
+        self.engine = SmartFunnelEngine()
+
+    def _profiles(self, personas):
+        result = asyncio.run(
+            self.engine.generate_funnel_context(personas, [])
+        )
+        self.assertTrue(result["success"])
+        return result["funnel_context"]["persona_profiles"]
+
+    def test_tofu_body_approaches_differ_and_carry_own_pain_or_fear(self):
+        profiles = self._profiles([PERSONA_STELLA, PERSONA_MARCUS])
+        bodies = [
+            profile["messages"]["tofu"]["body_approach"] for profile in profiles
+        ]
+        self.assertNotEqual(bodies[0], bodies[1])
+        # Persona 0 lands on the pain-anchored template, persona 1 on the
+        # fear-anchored one — each carries its OWN token, never the other
+        # persona's.
+        self.assertIn("Pricing confusion", bodies[0])
+        self.assertNotIn("Chaos when jobs overlap", bodies[0])
+        self.assertIn("Losing repeat customers", bodies[1])
+        self.assertNotIn("Pricing confusion", bodies[1])
+
+    def test_no_stage_body_is_one_of_the_three_old_shared_sentences(self):
+        profiles = self._profiles([PERSONA_STELLA, PERSONA_MARCUS])
+        for profile in profiles:
+            for stage in ("tofu", "mofu", "bofu"):
+                body = profile["messages"][stage]["body_approach"]
+                for marker in OLD_SENTENCE_MARKERS:
+                    self.assertNotIn(
+                        marker,
+                        body,
+                        f"{stage} body_approach resurrects an old shared "
+                        f"sentence: {body}",
+                    )
+
+    def test_every_stage_text_is_nonempty_and_distinct_per_persona(self):
+        profiles = self._profiles([PERSONA_STELLA, PERSONA_MARCUS])
+        for profile in profiles:
+            bodies = [
+                profile["messages"][stage]["body_approach"]
+                for stage in ("tofu", "mofu", "bofu")
+            ]
+            headlines = [
+                profile["messages"][stage]["headline_angle"]
+                for stage in ("tofu", "mofu", "bofu")
+            ]
+            for text in bodies + headlines:
+                self.assertTrue(str(text).strip(), "stage text is empty")
+            for text_a, text_b in combinations(bodies, 2):
+                self.assertNotEqual(text_a, text_b)
+            for text_a, text_b in combinations(headlines, 2):
+                self.assertNotEqual(text_a, text_b)
+
+    def test_persona_index_zero_gets_pain_anchored_template_per_stage(self):
+        # The rotation is deterministic: persona 0 lands on template v0 in
+        # every stage, and v0 always anchors the persona's own pain.
+        profile = self._profiles([PERSONA_STELLA])[0]
+        for stage in ("tofu", "mofu", "bofu"):
+            self.assertIn(
+                "Pricing confusion",
+                profile["messages"][stage]["body_approach"],
+            )
+
