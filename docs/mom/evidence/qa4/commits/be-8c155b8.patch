+    @staticmethod
+    def _ai_texts_enabled() -> bool:
+        """
+        Kill-switch for the AI text tier (QA4-img15). FUNNEL_AI_TEXT is
+        "1" by default (tier enabled; every failure still degrades to the
+        deterministic templates). Set FUNNEL_AI_TEXT=0 (or false/no/off)
+        to force the deterministic template tier — recommended for CI,
+        offline runs, or when byte-identical funnel texts are required.
+        """
+        return os.getenv(FUNNEL_AI_TEXT_ENV, "1").strip().lower() in (
+            _FUNNEL_AI_TRUTHY
+        )
+
+    async def _ai_stage_texts(
+        self,
+        persona: Dict[str, Any],
+        persona_index: int,
+        brand_profile: Optional[Dict[str, Any]],
+    ) -> Optional[Dict[str, Dict[str, str]]]:
+        """
+        AI tier (QA4-img15): ONE batched JSON call per persona covering all
+        three stages, capped at the first ``_FUNNEL_AI_MAX_PERSONAS``
+        personas of a funnel build (cost guard). Any failure — kill-switch
+        off, over the cap, LLM error, timeout, malformed or incomplete
+        JSON — returns None so the caller uses the deterministic template
+        tier instead. This method never raises.
+        """
+        if not self._ai_texts_enabled():
+            return None
+        if persona_index >= _FUNNEL_AI_MAX_PERSONAS:
+            return None
+        try:
+            prompt = self._build_ai_texts_prompt(persona, brand_profile)
+            llm_result = await asyncio.wait_for(
+                self.llm_handler._call_llm(
+                    prompt=prompt,
+                    system_message=(
+                        "You are a senior performance marketer writing ad "
+                        "funnel messaging. Return ONLY valid JSON."
+                    ),
+                    temperature=0.7,
+                ),
+                timeout=_FUNNEL_AI_TIMEOUT_SECONDS,
+            )
+        except Exception as exc:
+            logger.info(
+                "Funnel AI text tier unavailable for persona index %d (%s); "
+                "using deterministic templates: %s",
+                persona_index,
+                persona.get("persona_name", "Unknown Persona"),
+                exc,
+            )
+            return None
+        parsed = self._parse_ai_stage_texts(llm_result.get("content", ""))
+        if parsed is None:
+            logger.info(
+                "Funnel AI text tier returned unusable JSON for persona "
+                "index %d (%s); using deterministic templates.",
+                persona_index,
+                persona.get("persona_name", "Unknown Persona"),
+            )
+        return parsed
+
+    def _build_ai_texts_prompt(
+        self,
+        persona: Dict[str, Any],
+        brand_profile: Optional[Dict[str, Any]],
+    ) -> str:
+        """
+        Prompt for the AI text tier (QA4-img15). Embeds this persona's own
+        pains, goals, fears and motivations plus the brand context already
+        available to the engine, so the returned headline_angle /
+        body_approach are persona-specific. The literal phrase
+        "Return ONLY valid JSON" also switches the LLM handler into JSON
+        response mode.
+        """
+
+        def _clean(values: Any) -> List[str]:
+            if values is None:
+                return []
+            if isinstance(values, str):
+                values = [values]
+            return [
+                str(value).strip()
+                for value in values
+                if value is not None and str(value).strip()
+            ]
+
+        pain_points = persona.get("pain_points")
+        if isinstance(pain_points, dict):
+            pains = _clean(pain_points.get("emotional_pains")) + _clean(
+                pain_points.get("functional_pains")
+            )
+        elif isinstance(pain_points, list):
+            pains = _clean(pain_points)
+        else:
+            pains = []
+
+        goals_source = persona.get("goals_motivations")
+        if isinstance(goals_source, dict):
+            goals = _clean([goals_source.get("primary_goal")]) + _clean(
+                goals_source.get("secondary_goals")
+            )
+            fears = _clean(goals_source.get("fears_anti_goals"))
+        elif isinstance(goals_source, list):
+            goals = _clean(goals_source)
+            fears = []
+        else:
+            goals = []
+            fears = []
+
+        name = str(persona.get("persona_name") or "").strip() or "this audience"
+
+        brand_bits: List[str] = []
+        if isinstance(brand_profile, dict):
+            for key, value in brand_profile.items():
+                if isinstance(value, (str, int, float)) and str(value).strip():
+                    brand_bits.append(f"{key}: {value}")
+        brand_context = "; ".join(brand_bits[:12]) if brand_bits else "Not provided"
+
+        return (
+            "Return ONLY valid JSON for funnel stage messaging for ONE "
+            "customer persona.\n\n"
+            f"Persona name: {name}\n"
+            f"Pain points: {'; '.join(pains) if pains else '(none provided)'}\n"
+            "Goals and motivations: "
+            f"{'; '.join(goals) if goals else '(none provided)'}\n"
+            "Fears and anti-goals: "
+            f"{'; '.join(fears) if fears else '(none provided)'}\n"
+            f"Brand context: {brand_context}\n\n"
+            "For each of the three stages \"tofu\" (awareness), \"mofu\" "
+            "(consideration) and \"bofu\" (conversion) write:\n"
+            "- \"headline_angle\": one sentence (max 90 characters) naming "
+            "the ad angle for that stage, built from THIS persona's own "
+            "pains, fears and goals; always mention the persona name.\n"
+            "- \"body_approach\": one sentence (max 140 characters) "
+            "describing how the ad body should speak to this persona in "
+            "that stage, referencing their specific pain, fear or goal.\n\n"
+            "JSON shape:\n"
+            '{"tofu": {"headline_angle": "...", "body_approach": "..."}, '
+            '"mofu": {"headline_angle": "...", "body_approach": "..."}, '
+            '"bofu": {"headline_angle": "...", "body_approach": "..."}}'
+        )
+
+    @staticmethod
+    def _parse_ai_stage_texts(content: Any) -> Optional[Dict[str, Dict[str, str]]]:
+        """
+        Parse + validate the AI tier response (QA4-img15). Returns per-stage
+        {"headline_angle", "body_approach"} only when ALL three stages carry
+        non-empty text for both fields; anything else (prose, markdown
+        fences, missing stages, empty strings, non-JSON) returns None so the
+        caller falls back to the deterministic templates.
+        """
+        if content is None:
+            return None
+        text = str(content).strip()
+        if not text:
+            return None
+        if text.startswith("```"):
+            text = text[3:]
+            newline = text.find("\n")
+            if newline != -1:
+                text = text[newline + 1 :]
+            if text.rstrip().endswith("```"):
+                text = text.rstrip()[:-3]
+        try:
+            data = json.loads(text)
+        except (TypeError, ValueError):
+            return None
+        if not isinstance(data, dict):
+            return None
+        parsed: Dict[str, Dict[str, str]] = {}
+        for stage in ("tofu", "mofu", "bofu"):
+            entry = data.get(stage)
+            if not isinstance(entry, dict):
+                return None
+            headline = str(entry.get("headline_angle") or "").strip()
+            body = str(entry.get("body_approach") or "").strip()
+            if not headline or not body:
+                return None
+            parsed[stage] = {"headline_angle": headline, "body_approach": body}
+        return parsed
+
     def _persona_message_hooks(
         self, persona: Dict[str, Any], persona_index: int
     ) -> Dict[str, str]:
