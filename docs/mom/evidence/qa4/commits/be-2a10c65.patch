+    def test_expired_cache_is_rescraped(self):
+        """QA4-MOM (cache expiry): a reused scrape older than
+        SITE_DATA_MAX_AGE_DAYS is treated as a miss and re-scraped."""
+        owned = BrandWebsiteData.objects.create(
+            identity=self.brand_a.identity,
+            brand=self.brand_a,
+            website_url=self.brand_a.website_url,
+            title="Old Scrape",
+            full_text="old text",
+        )
+        # backdate the row beyond the expiry window
+        BrandWebsiteData.objects.filter(pk=owned.pk).update(
+            updated_at=timezone.now() - timedelta(days=40)
+        )
+
+        orchestrator = self._orchestrator()
+        with patch.dict(os.environ, {"SITE_DATA_MAX_AGE_DAYS": "30"}):
+            with self._patch_scraper("Fresh Scrape") as scraper_mock:
+                result = async_to_sync(orchestrator._get_or_scrape_website_data)(
+                    self.brand_a,
+                    force_refresh=False,
+                )
+        scraper_mock.assert_called_once()
+        self.assertEqual(result.title, "Fresh Scrape")
+        # the stale OWNED row is refreshed in place (copy-on-write preserved)
+        self.assertEqual(result.pk, owned.pk)
+
+    def test_fresh_cache_is_reused(self):
+        """A scrape inside the expiry window is still served from cache."""
+        owned = BrandWebsiteData.objects.create(
+            identity=self.brand_a.identity,
+            brand=self.brand_a,
+            website_url=self.brand_a.website_url,
+            title="Recent Scrape",
+            full_text="recent text",
+        )
+
+        orchestrator = self._orchestrator()
+        with patch.dict(os.environ, {"SITE_DATA_MAX_AGE_DAYS": "30"}):
+            with self._patch_scraper("Should Not Run") as scraper_mock:
+                result = async_to_sync(orchestrator._get_or_scrape_website_data)(
+                    self.brand_a,
+                    force_refresh=False,
+                )
+        scraper_mock.assert_not_called()
+        self.assertEqual(result.pk, owned.pk)
+
