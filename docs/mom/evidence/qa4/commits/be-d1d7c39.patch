@@ -0,0 +1,85 @@
+"""QA4 security hardening tests.
+
+Covers:
+- Global default ``IsAuthenticated`` permission: unauthenticated API requests
+  must be rejected with 401.
+- ``auth`` throttle scope on the login (token obtain) endpoint: rapid attempts
+  hit 429.
+- Public ``/health/version/`` build metadata endpoint (QA4-E0).
+"""
+
+import os
+from unittest.mock import patch
+
+from django.core.cache import cache
+from django.test import TestCase
+from rest_framework import status
+from rest_framework.test import APIClient
+from rest_framework.throttling import ScopedRateThrottle
+
+from authentication.views import CustomTokenObtainPairView
+
+LOGIN_URL = "/api/v1/auth/token/"
+PROTECTED_URL = "/api/v1/brands/"
+HEALTH_VERSION_URL = "/health/version/"
+
+
+class DefaultPermissionTests(TestCase):
+    """The REST_FRAMEWORK default permission is IsAuthenticated."""
+
+    def test_unauthenticated_request_to_protected_endpoint_returns_401(self):
+        response = APIClient().get(PROTECTED_URL)
+        self.assertEqual(response.status_code, status.HTTP_401_UNAUTHORIZED)
+
+
+class _TwoPerMinuteAuthThrottle(ScopedRateThrottle):
+    """Test-only ScopedRateThrottle pinned to 2/min regardless of settings.
+
+    THROTTLE_RATES is resolved at class-definition time in DRF, so an explicit
+    subclass (instead of override_settings) keeps this test deterministic.
+    """
+
+    THROTTLE_RATES = {"auth": "2/min"}
+
+
+class AuthThrottleTests(TestCase):
+    """The login endpoint is throttled through the 'auth' scope."""
+
+    def setUp(self):
+        cache.clear()
+
+    def test_rapid_login_attempts_are_rate_limited(self):
+        payload = {"username": "no-such-user", "password": "wrong-password"}
+        with patch.object(
+            CustomTokenObtainPairView,
+            "throttle_classes",
+            [_TwoPerMinuteAuthThrottle],
+        ):
+            first = self.client.post(LOGIN_URL, payload, format="json")
+            second = self.client.post(LOGIN_URL, payload, format="json")
+            third = self.client.post(LOGIN_URL, payload, format="json")
+
+        # The first two attempts pass the throttle and fail authentication
+        # with 400 (invalid credentials); the third is throttled.
+        self.assertEqual(first.status_code, status.HTTP_400_BAD_REQUEST)
+        self.assertEqual(second.status_code, status.HTTP_400_BAD_REQUEST)
+        self.assertEqual(third.status_code, status.HTTP_429_TOO_MANY_REQUESTS)
+
+
+class HealthVersionTests(TestCase):
+    """GET /health/version/ exposes build metadata without authentication."""
+
+    def test_health_version_returns_expected_keys(self):
+        response = self.client.get(HEALTH_VERSION_URL)
+
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
+        body = response.json()
+        self.assertEqual(
+            body["version"], os.getenv("APP_VERSION", "dev")
+        )
+        self.assertIn("commit", body)
+        self.assertIn("build_at", body)
+
+    def test_health_version_is_public(self):
+        response = APIClient().get(HEALTH_VERSION_URL)
+        self.assertEqual(response.status_code, status.HTTP_200_OK)
