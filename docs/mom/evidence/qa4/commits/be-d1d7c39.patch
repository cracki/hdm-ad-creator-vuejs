+# Django core
+# Unset (or 0/false) means DEBUG=False. Set to 1 only for local development.
+DJANGO_DEBUG=0
+# Required when DJANGO_DEBUG=0. Generate with:
+#   python -c "import secrets; print(secrets.token_urlsafe(64))"
+SECRET_KEY=change-me
+
+# Hosts / CORS
+ALLOWED_HOSTS=localhost,127.0.0.1
+# Comma-separated list. Only used when DJANGO_DEBUG=0 (dev allows all origins).
+CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
+
+# Database
+POSTGRES_DB=ad_creator
+POSTGRES_USER=postgres
+POSTGRES_PASSWORD=postgres
+POSTGRES_HOST=127.0.0.1
+POSTGRES_PORT=5432
+
+# Build metadata surfaced by GET /health/version/
+APP_VERSION=dev
+GIT_COMMIT=
+BUILD_AT=
+
+# Celery
+CELERY_BROKER_URL=redis://localhost:6379/0
+CELERY_RESULT_BACKEND=redis://localhost:6379/0
