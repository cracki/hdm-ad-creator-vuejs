index 0000000..3d3a6ae
--- /dev/null
+++ b/django-backend/core/utils/text_patterns.py
@@ -0,0 +1,123 @@
+"""Shared text blocklist patterns for junk service/USP filtering (QA4).
+
+The client QA report (junk-services chain img2/img8/new6) showed website
+chrome leaking into service lists: auth widget headings ("Sign in or
+register", "Reset password"), nav/CTA labels, blog titles ("7 Warning
+Signs Your Dubai Property"), and marketing sentences ("with an average
+rating of 4", "Book home services in less than 60 seconds", "renovation
+company in Dubai").
+
+These compiled patterns are consumed by BOTH ``brand/text_utils.py``
+(list filtering) and ``core/utils/scraper.py`` (heading/card skipping),
+so they live in a dependency-free module — no imports from scraper or
+text_utils here to avoid circular imports.
+"""
+
+import re
+
+# Auth/account widget phrases. Matches heading case and sentence case
+# ("Reset Password" and "Reset password" both match).
+AUTH_PATTERNS = re.compile(
+    r"\b(?:"
+    r"sign[\s-]*in"
+    r"|sign[\s-]*up"
+    r"|log[\s-]*in"
+    r"|log[\s-]*out"
+    r"|login"
+    r"|registr\w*"
+    r"|reset[\s-]+password"
+    r"|forgot[\s-]+password"
+    r"|create[\s-]+account"
+    r"|get[\s-]+started"
+    r"|my[\s-]+account"
+    r")\b",
+    re.IGNORECASE,
+)
+
+# Auth link hrefs (/signin, /login, /reset-password, ...). Used to skip
+# whole sign-in cards during service extraction.
+AUTH_HREF_PATTERN = re.compile(
+    r"(?:"
+    r"sign[-_]?in"
+    r"|sign[-_]?up"
+    r"|log[-_]?in"
+    r"|log[-_]?out"
+    r"|login"
+    r"|signin"
+    r"|signup"
+    r"|register"
+    r"|password"
+    r"|my-account"
+    r")",
+    re.IGNORECASE,
+)
+
+# Nav/CTA button labels that end up as fake "services".
+CTA_PATTERNS = re.compile(
+    r"\b(?:"
+    r"book\s+now"
+    r"|get\s+a\s+quote"
+    r"|contact\s+us"
+    r"|learn\s+more"
+    r"|read\s+more"
+    r"|view\s+all"
+    r"|call\s+now"
+    r"|order\s+now"
+    r"|subscribe"
+    r"|download\s+now"
+    r")\b",
+    re.IGNORECASE,
+)
+
+# Blog/article titles: "7 Warning Signs Your Dubai Property ...",
+# "5 Tips For ...". A leading number plus listicle keyword.
+BLOG_TITLE_PATTERNS = re.compile(
+    r"^\s*\d+\b[^.!?]{0,80}?\b(?:"
+    r"signs"
+    r"|tips"
+    r"|ways"
+    r"|reasons"
+    r"|things"
+    r"|mistakes"
+    r"|questions"
+    r")\b",
+    re.IGNORECASE,
+)
+
+# Marketing sentences/fragments, not productized services:
+# - "with an average rating of 4" / "rating of 4.9"
+# - "trusted by 500+ clients"
+# - "years of experience" claims
+# - "best-in-class"
+# - "Book ... in 60 seconds/minutes" booking-speed claims
+# - "<business type> ... in <place>" SEO headings
+#   ("renovation company in Dubai")
+MARKETING_SENTENCE_PATTERNS = re.compile(
+    r"(?:"
+    r"with\s+an\s+average\s+rating"
+    r"|rating\s+of"
+    r"|trusted\s+by"
+    r"|years\s+of\s+experience"
+    r"|best[-\s]in[-\s]class"
+    r"|\bbook\b[^.!?]{0,60}?\b(?:seconds?|minutes?|mins?|secs?)\b"
+    r"|\b(?:company|agency|firm|contractors?|providers?|specialists?"
+    r"|experts?)\b[^.!?]{0,60}?\bin\s+\w+"
+    r")",
+    re.IGNORECASE,
+)
+
+
+def matches_service_blocklist(text: object) -> bool:
+    """True when ``text`` matches any QA4 junk blocklist pattern.
+
+    Convenience wrapper so filter/scrape call sites need a single check.
+    Non-string values never match.
+    """
+    if not isinstance(text, str):
+        return False
+    return bool(
+        AUTH_PATTERNS.search(text)
+        or CTA_PATTERNS.search(text)
+        or BLOG_TITLE_PATTERNS.search(text)
+        or MARKETING_SENTENCE_PATTERNS.search(text)
+    )
