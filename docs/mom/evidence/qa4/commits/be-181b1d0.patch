+++ b/django-backend/brand/tests_qa4_services.py
@@ -0,0 +1,306 @@
+"""QA4 junk-services regression tests (chain img2 / img8 / new6).
+
+Covers the four layers of the junk-services fix:
+
+1. Text filter (``brand.text_utils.filter_junk_text_list``): the 7 QA
+   strings are dropped, real services survive, and the service-keyword
+   bypass no longer shields marketing sentences.
+2. Scraper (``core.utils.scraper``): auth widgets, nav lists, blog cards
+   and CTA headings never reach the extracted services.
+3. Merge choke point (``brand.services.brand_services``): the final
+   merged service list is junk-filtered and never contains usp_list
+   sentences; the core-analysis ``services`` field wins over usp_list.
+4. Analyzer parse (``brand.analyzers.brand_core_analyzer``): the LLM
+   ``services`` array is parsed separately from ``usp_list``.
+
+No LLM calls are made anywhere in this module.
+"""
+
+from unittest import mock
+
+from bs4 import BeautifulSoup
+from django.test import SimpleTestCase, TestCase
+
+from brand.analyzers.brand_core_analyzer import build_core_analysis_payload
+from brand.models import (
+    Brand,
+    BrandCoreAnalysis,
+    BrandService,
+    BrandWebsiteData,
+    Industry,
+)
+from brand.services.brand_services import (
+    get_core_service_names,
+    get_merged_service_names,
+)
+from brand.text_utils import _has_service_indicator, filter_junk_text_list
+from core.utils.scraper import WebsiteScraper
+
+# The 7 strings from the client QA report that all survived the old filter.
+QA_JUNK_SERVICES = [
+    "with an average rating of 4",
+    "Book home services in less than 60 seconds",
+    "Sign in or register",
+    "Reset password",
+    "renovation company in Dubai",
+    "Villas",
+    "7 Warning Signs Your Dubai Property",
+]
+
+# Real, concrete productized services that MUST survive every layer.
+REAL_SERVICES = [
+    "Home Cleaning",
+    "AC Cleaning",
+    "Deep Cleaning",
+    "AC Repair",
+    "Handyman Services",
+    "Laundry & Ironing",
+    "Villa Renovation",
+    "Deep Cleaning Services",
+    "Car Engine Repair",
+]
+
+# Sign-in widget card, a nav list, a blog card, an auth-linked card and a
+# real services grid — mirrors the QA4 leak sources.
+QA_SCRAPER_HTML = """
+<html><body>
+  <nav class="main-nav">
+    <ul>
+      <li><a href="/services">Services</a></li>
+      <li><a href="/about">About Us</a></li>
+    </ul>
+  </nav>
+  <div class="login-card box">
+    <h3>Sign in or register</h3>
+    <form action="/login"><input type="email"><button>Reset password</button></form>
+  </div>
+  <div class="portal-box item">
+    <h3>Member Portal</h3>
+    <a href="/reset-password">Reset password</a>
+  </div>
+  <div class="blog-card item">
+    <h3>7 Warning Signs Your Dubai Property Needs Maintenance</h3>
+    <a href="/blog">Read more</a>
+  </div>
+  <div class="services-grid service">
+    <div class="service-card item"><h3>Deep Cleaning</h3></div>
+    <div class="service-card item"><h3>AC Repair</h3></div>
+  </div>
+</body></html>
+"""
+
+
+class FilterJunkServicesTests(SimpleTestCase):
+    """Layer 1: the shared text filter drops QA junk, keeps real services."""
+
+    def test_qa4_junk_strings_dropped_in_services_context(self):
+        self.assertEqual(
+            filter_junk_text_list(QA_JUNK_SERVICES, services_context=True),
+            [],
+        )
+
+    def test_reset_password_dropped_in_both_cases(self):
+        # "Reset Password" (title case) used to be caught as a person name;
+        # "Reset password" (sentence case) survived. The AUTH pattern must
+        # drop both explicitly.
+        self.assertEqual(
+            filter_junk_text_list(
+                ["Reset Password", "reset password", "Sign In Or Register"],
+                services_context=True,
+            ),
+            [],
+        )
+
+    def test_real_services_kept_in_services_context(self):
+        self.assertEqual(
+            filter_junk_text_list(REAL_SERVICES, services_context=True),
+            REAL_SERVICES,
+        )
+
+    def test_real_services_kept_in_default_context(self):
+        self.assertEqual(filter_junk_text_list(REAL_SERVICES), REAL_SERVICES)
+
+    def test_services_context_scoping(self):
+        # >8-word strings and service-less single words are dropped ONLY in
+        # the services context (USP/keyword lists keep their own rules).
+        self.assertEqual(
+            filter_junk_text_list(["Villas", "Massage"], services_context=True),
+            ["Massage"],
+        )
+        self.assertEqual(filter_junk_text_list(["Villas"]), ["Villas"])
+        self.assertEqual(
+            filter_junk_text_list(
+                ["We are the leading provider of premium cleaning solutions across the entire region"],
+                services_context=True,
+            ),
+            [],
+        )
+
+    def test_service_keyword_bypass_no_longer_shields_marketing(self):
+        # "services" used to bypass every junk check; long/blocklisted
+        # strings no longer get the exemption.
+        self.assertFalse(
+            _has_service_indicator("Book home services in less than 60 seconds")
+        )
+        self.assertTrue(_has_service_indicator("Home Cleaning"))
+        self.assertTrue(_has_service_indicator("Aromatherapy Session"))
+
+    def test_cta_and_blog_titles_dropped_everywhere(self):
+        junk = ["Get a quote", "7 Tips For A Cleaner Home", "5 Ways To Reset"]
+        self.assertEqual(filter_junk_text_list(junk), [])
+        self.assertEqual(filter_junk_text_list(junk, services_context=True), [])
+
+
+class ScraperServiceExtractionTests(SimpleTestCase):
+    """Layer 2: scraper skips auth/nav/blog regions during extraction."""
+
+    def _extract_services(self, html):
+        scraper = WebsiteScraper()
+        soup = BeautifulSoup(html, "html.parser")
+        # Production flow: extraction reads the junk-free copy of the tree.
+        scraper._strip_junk_regions(soup)
+        full_text = soup.get_text(" ", strip=True)
+        return scraper._extract_services_enhanced(soup, full_text)
+
+    def test_auth_nav_and_blog_junk_absent_real_services_present(self):
+        services = self._extract_services(QA_SCRAPER_HTML)
